{
  "weft": "0.1",
  "root": {
    "kind": "screen",
    "id": "root",
    "props": { "label": "Document", "weft": "0.1" },
    "children": [
      {
        "kind": "menu",
        "id": "actions",
        "props": { "label": "Document actions" },
        "children": [
          {
            "kind": "each",
            "id": "action-each",
            "props": { "as": "action", "in": { "bind": "$.actions" } },
            "children": [
              {
                "kind": "menu-item",
                "id": "action-item",
                "props": { "disabled": { "bind": "$action.enabled", "not": true } },
                "on": { "press": "doc.run" },
                "children": ["Run"]
              }
            ]
          }
        ]
      }
    ]
  }
}
