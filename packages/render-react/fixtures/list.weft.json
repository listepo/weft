{
  "weft": "0.1",
  "root": {
    "kind": "screen",
    "id": "root",
    "props": { "label": "Todos", "weft": "0.1" },
    "children": [
      {
        "kind": "list",
        "id": "todos",
        "props": { "ordered": false, "state": "ready" },
        "children": [
          {
            "kind": "each",
            "id": "todo-each",
            "props": { "as": "todo", "in": { "bind": "$.todos" } },
            "children": [
              {
                "kind": "item",
                "id": "todo-item",
                "children": [
                  {
                    "kind": "text",
                    "id": "todo-title",
                    "props": { "value": { "bind": "$todo.title" } }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
