<screen id="root" weft="0.1" label="Delivery">
  <radio-group id="speed" label="Delivery speed" value="{$.speed}">
    <radio id="speed-std" value="standard" disabled="false">Standard</radio>
    <radio id="speed-fast" value="express" disabled="{!$.expressAvailable}">Express</radio>
  </radio-group>
</screen>
