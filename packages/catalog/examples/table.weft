<screen id="root" label="Orders" weft="0.1">
  <table id="orders" label="Recent orders" state="ready">
    <column id="col-id">Order</column>
    <column id="col-total" sort="descending" on-press="orders.sort">Total</column>
    <each id="order-each" as="order" in="{$.orders}">
      <row id="order-row" selected="false">
        <cell id="order-id">
          <text id="order-id-text" text="{$order.id}"/>
        </cell>
        <cell id="order-total">
          <text id="order-total-text" text="{$order.total}"/>
        </cell>
      </row>
    </each>
  </table>
</screen>
