{
  "name": "@weft/core",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "weft": "./src/cli.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./wasm": "./src/wasm.ts",
    "./web": "./src/web.ts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "fast-check": "4.10.2"
  },
  "napi": {
    "binaryName": "weft",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  }
}
