{
  "color": {
    "$type": "color",
    "brand": { "$value": "#1f2937" },
    "star": { "$value": "{color.brand}" }
  },
  "space": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 16, "unit": "px" } }
  },
  "font": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "system-ui",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": 400,
        "letterSpacing": { "value": 0.2, "unit": "px" },
        "lineHeight": 1.5
      }
    }
  }
}
