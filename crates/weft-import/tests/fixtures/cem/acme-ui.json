          "customElement": true
        },
        {
          "kind": "class",
          "name": "AcmeBadgeAgain",
          "tagName": "acme-badge",
          "slots": [],
          "customElement": true
        },
        { "kind": "class", "name": "AcmeLegacy", "tagName": "acme_legacy", "customElement": true },
        { "kind": "class", "name": "Hidden", "tagName": "x-acme-hidden", "customElement": true },
        { "kind": "class", "name": "Orphan", "customElement": true },
        { "kind": "class", "name": "AcmeDate", "tagName": "date-picker", "customElement": true },
        { "kind": "mixin", "name": "FormMixin", "customElement": true, "parameters": [{ "name": "base" }] },
        { "kind": "class", "name": "Util" },
        { "kind": "function", "name": "register", "parameters": [] },
        { "kind": "variable", "name": "version", "type": { "text": "string" } }
      ],
      "exports": [
        { "kind": "custom-element-definition", "name": "acme-badge", "declaration": { "name": "AcmeBadge", "module": "src/card/card.js" } },
        { "kind": "custom-element-definition", "name": "lit-button", "declaration": { "name": "LitButton", "package": "lit" } }
      ]
    }
  ]
