import { Button, CheckBox, ComboBox, LineEdit, Slider, SpinBox, TextEdit, VerticalBox } from "std-widgets.slint";

export component ControlsScreen inherits Window {
    title: root.title_text;
    in-out property <string> title_text;
    in-out property <string> age;
    in-out property <string> bio;
    in-out property <float> volume;
    in-out property <int> count;
    in-out property <bool> agree;
    in-out property <string> note;
    callback perform(string, string);

    controls := VerticalBox {
        alignment: LayoutAlignment.start;
        title := Text {
            text: "Say \"hi\" \\{x} & more";
            font-size: 24px;
            font-weight: 700;
        }
        layout := GridLayout {
            spacing: 8px;
            VerticalLayout {
                row: 0;
                col: 0;
                Text { text: "Age"; }
                age := LineEdit {
                    input-type: InputType.number;
                    placeholder-text: "0";
                    text <=> root.age;
                    edited => { root.perform("form.age", "age"); }
                }
            }
            VerticalLayout {
                row: 0;
                col: 1;
                Text { text: "Bio"; }
                bio := TextEdit {
                    text <=> root.bio;
                }
            }
            VerticalLayout {
                row: 1;
                col: 0;
                Text { text: "Volume"; }
                volume := Slider {
                    minimum: 0;
                    maximum: 10;
                    value <=> root.volume;
                    changed => { root.perform("audio.volume", "volume"); }
                }
            }
            VerticalLayout {
                row: 1;
                col: 1;
                Text { text: "Count"; }
                count := SpinBox {
                    minimum: 1;
                    value <=> root.count;
                }
            }
        }
        row := HorizontalLayout {
            spacing: 16px;
            agree := CheckBox {
                text: "Agree";
                checked <=> root.agree;
                toggled => { root.perform("form.agree", "agree"); }
            }
            note := Text {
                text: root.note;
                visible: root.agree;
            }
            secret := Text {
                text: "Hidden";
                visible: false;
            }
        }
        VerticalLayout {
            Text { text: "Size"; }
            size := ComboBox {
                model: ["Small", "Medium"];
                current-index: 1;
            }
        }
        reset := Button {
            text: "Reset";
            enabled: true;
            clicked => { root.perform("form.reset", "reset"); }
        }
    }
}
