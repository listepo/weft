import { VerticalBox } from "std-widgets.slint";

export component ReceiptScreen inherits Window {
    title: "Receipt";
    in-out property <string> subtotal;
    in-out property <string> total;
    callback perform(string, string);

    receipt := VerticalBox {
        alignment: LayoutAlignment.start;
        lines := VerticalLayout {
            alignment: LayoutAlignment.start;
            subtotal--row := HorizontalLayout {
                vertical-stretch: 0;
                alignment: LayoutAlignment.space-between;
                subtotal--name := Text {
                    horizontal-stretch: 0;
                    text: "Subtotal";
                }
                subtotal--value := Text {
                    horizontal-stretch: 0;
                    text: root.subtotal;
                }
            }
            total--row := HorizontalLayout {
                vertical-stretch: 0;
                alignment: LayoutAlignment.space-between;
                total--name := Text {
                    horizontal-stretch: 0;
                    text: "Total";
                }
                total--value := Text {
                    horizontal-stretch: 0;
                    text: root.total;
                }
            }
        }
    }
}
