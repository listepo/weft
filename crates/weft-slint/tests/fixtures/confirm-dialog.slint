import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";

export component FilesScreen inherits Window {
    title: "File";
    in-out property <bool> confirmOpen;
    in-out property <string> file-name;
    callback perform(string, string);

    files := VerticalBox {
        alignment: LayoutAlignment.start;
        title := Text {
            text: "Quarterly report";
            font-size: 32px;
            font-weight: 700;
        }
        delete-file := Button {
            text: "Delete file";
            clicked => { root.perform("dialog.open", "delete-file"); }
        }
        confirm := PopupWindow {
            close-policy: PopupClosePolicy.no-auto-close;
            VerticalLayout {
                Text { text: "Delete file?"; }
                warning := Text {
                    text: "This cannot be undone.";
                }
                filename := Text {
                    text: root.file-name;
                }
                HorizontalBox {
                    cancel := Button {
                        text: "Cancel";
                        clicked => { root.perform("dialog.close", "cancel"); }
                    }
                    confirm-delete := Button {
                        text: "Delete";
                        clicked => { root.perform("file.delete", "confirm-delete"); }
                    }
                }
            }
        }
    }
    init => {
        if root.confirmOpen { confirm.show(); }
    }
    changed confirmOpen => { if root.confirmOpen { confirm.show(); } else { confirm.close(); } }
    property <bool> confirm-is-open: confirm.is-open;
    changed confirm-is-open => { if !confirm-is-open && root.confirmOpen { root.confirmOpen = false; root.perform("dialog.close", "confirm"); } }
}
