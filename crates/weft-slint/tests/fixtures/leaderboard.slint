import { ListView, VerticalBox } from "std-widgets.slint";

export component LeaderboardScreen inherits Window {
    title: "Leaderboard";
    in-out property <[{ name: string, score: string }]> players;
    callback perform(string, string);

    leaderboard := VerticalBox {
        alignment: LayoutAlignment.start;
        title := Text {
            text: "Leaderboard";
            font-size: 32px;
            font-weight: 700;
        }
        leader := HorizontalLayout {
            alignment: LayoutAlignment.start;
            spacing: 4px;
            leader-label := Text {
                horizontal-stretch: 0;
                text: "In the lead:";
            }
            leader-name := Text {
                horizontal-stretch: 0;
                text: root.players[0].name;
            }
        }
        players := ListView {
            for player in root.players: VerticalLayout {
                player-name := Text {
                    text: player.name;
                }
                player-score := Text {
                    text: player.score;
                }
            }
        }
    }
}
