import { Button, LineEdit, Palette, VerticalBox } from "std-widgets.slint";

export component LayoutScreen inherits Window {
    title: "Layout";
    in-out property <string> query;
    callback perform(string, string);

    layout := VerticalBox {
        alignment: LayoutAlignment.start;
        toolbar := HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                Text { text: "Search"; }
                search := LineEdit {
                    text <=> root.query;
                }
            }
            filter := Button {
                text: "Filter";
                clicked => { root.perform("list.filter", "filter"); }
            }
        }
        pager := HorizontalLayout {
            spacing: 8px;
            previous := TouchArea {
                clicked => { root.perform("list.previous", "previous"); }
                Text { text: "Previous"; color: Palette.accent-background; }
            }
            next := TouchArea {
                clicked => { root.perform("list.next", "next"); }
                Text { text: "Next"; color: Palette.accent-background; }
            }
        }
        actions := HorizontalLayout {
            spacing: 8px;
            cancel := Button {
                text: "Cancel";
                clicked => { root.perform("list.cancel", "cancel"); }
            }
            save := Button {
                text: "Save";
                primary: true;
                clicked => { root.perform("list.save", "save"); }
            }
        }
    }
}
