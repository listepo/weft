import { Button, GroupBox, LineEdit, VerticalBox } from "std-widgets.slint";

export component TiltScreen inherits Window {
    title: "Card flips";
    in-out property <string> front;
    in-out property <string> back;
    in-out property <string> note;
    callback perform(string, string);

    tilt := VerticalBox {
        alignment: LayoutAlignment.start;
        title := Text {
            text: "Card flips";
            font-size: 32px;
            font-weight: 700;
        }
        deck := VerticalLayout {
            alignment: LayoutAlignment.start;
            spacing: 24px;
            front := GroupBox {
                vertical-stretch: 0;
                title: "Front side";
                VerticalBox {
                    front-title := Text {
                        text: "Front";
                        font-size: 24px;
                        font-weight: 700;
                    }
                    front-text := Text {
                        text: root.front;
                    }
                    front-flip := Button {
                        text: "Flip";
                        primary: true;
                        clicked => { root.perform("card.flip", "front-flip"); }
                    }
                }
            }
            back := GroupBox {
                vertical-stretch: 0;
                title: "Back side";
                VerticalBox {
                    back-title := Text {
                        text: "Back";
                        font-size: 24px;
                        font-weight: 700;
                    }
                    back-text := Text {
                        text: root.back;
                    }
                    back-flip := Button {
                        text: "Flip";
                        clicked => { root.perform("card.flip", "back-flip"); }
                    }
                }
            }
            lean := GroupBox {
                vertical-stretch: 0;
                title: "Leaning card";
                VerticalBox {
                    lean-title := Text {
                        text: "Leaning";
                        font-size: 24px;
                        font-weight: 700;
                    }
                    lean-text := Text {
                        text: "Tilted back and turned a little in the plane.";
                    }
                    VerticalLayout {
                        Text { text: "Note"; }
                        lean-note := LineEdit {
                            placeholder-text: "Add a note";
                            text <=> root.note;
                            edited => { root.perform("note.edit", "lean-note"); }
                        }
                    }
                }
            }
        }
    }
}
