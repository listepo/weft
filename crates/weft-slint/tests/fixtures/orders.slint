import { StandardTableView, VerticalBox } from "std-widgets.slint";

export component OrdersScreen inherits Window {
    title: "Orders";
    in-out property <string> labels-total;
    in-out property <[{ selected: bool, id: string, total: string }]> orders;
    callback perform(string, string);

    orders := VerticalBox {
        alignment: LayoutAlignment.start;
        title := Text {
            text: "Orders";
            font-size: 24px;
            font-weight: 700;
        }
        open-orders := VerticalLayout {
            StandardTableView {
                accessible-label: "Open orders";
                columns: [{ title: "Order", sort-order: SortOrder.descending }, { title: root.labels-total }];
                sort-ascending(column) => { if column == 0 { root.perform("orders.sortById", "col-id"); } }
                sort-descending(column) => { if column == 0 { root.perform("orders.sortById", "col-id"); } }
                row-pointer-event(row, event, position) => { if event.kind == PointerEventKind.up { root.perform("orders.open", "order"); } }
            }
            if root.orders.length == 0: VerticalLayout {
                no-orders := Text {
                    text: "No open orders.";
                }
            }
        }
        archived := VerticalLayout {
            StandardTableView {
                accessible-label: "Archived orders";
                columns: [{ title: "Order" }];
            }
            archived-empty := Text {
                text: "Nothing archived yet.";
            }
        }
        pending := StandardTableView {
            accessible-label: "Pending orders";
            columns: [{ title: "Order" }];
            rows: [[{ text: "Fetching…" }]];
            current-row: 0;
        }
    }
}
