import { Button, GroupBox, VerticalBox } from "std-widgets.slint";

export component ShowroomScreen inherits Window {
    title: "Showroom";
    in-out property <string> caption;
    callback perform(string, string);

    showroom := VerticalBox {
        alignment: LayoutAlignment.start;
        title := Text {
            text: "Showroom";
            font-size: 32px;
            font-weight: 700;
        }
        shelf := VerticalLayout {
            alignment: LayoutAlignment.start;
            spacing: 24px;
            gem-section := GroupBox {
                vertical-stretch: 0;
                title: "Gem";
                VerticalBox {
                    gem-title := Text {
                        text: "Gem";
                        font-size: 24px;
                        font-weight: 700;
                    }
                    gem := Image {
                        accessible-label: "A teal gem with eight triangular faces";
                    }
                    gem-caption := Text {
                        text: root.caption;
                    }
                    gem-pick := Button {
                        text: "Choose this gem";
                        primary: true;
                        clicked => { root.perform("gem.pick", "gem-pick"); }
                    }
                }
            }
            turned-section := GroupBox {
                vertical-stretch: 0;
                title: "Turned gem";
                VerticalBox {
                    turned-title := Text {
                        text: "Turned";
                        font-size: 24px;
                        font-weight: 700;
                    }
                    turned := Image {
                        accessible-label: "The same gem turned to its side";
                    }
                    turned-caption := Text {
                        text: "Without a USDZ file Apple platforms show the still image.";
                    }
                }
            }
        }
    }
}
