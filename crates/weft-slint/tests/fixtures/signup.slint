import { Button, CheckBox, HorizontalBox, LineEdit, Palette, VerticalBox } from "std-widgets.slint";

export component SignupScreen inherits Window {
    title: "Create account";
    in-out property <string> name;
    in-out property <string> email;
    in-out property <string> password;
    in-out property <string> confirm;
    in-out property <bool> acceptTerms;
    callback perform(string, string);

    signup := VerticalBox {
        alignment: LayoutAlignment.start;
        form := VerticalBox {
            title := Text {
                text: "Create your account";
                font-size: 32px;
                font-weight: 700;
            }
            fields := VerticalLayout {
                alignment: LayoutAlignment.start;
                spacing: 16px;
                VerticalLayout {
                    vertical-stretch: 0;
                    Text { text: "Full name"; }
                    name := LineEdit {
                        text <=> root.name;
                        accepted => { root.perform("auth.signup", "form"); }
                    }
                }
                VerticalLayout {
                    vertical-stretch: 0;
                    Text { text: "Email"; }
                    email := LineEdit {
                        text <=> root.email;
                        accepted => { root.perform("auth.signup", "form"); }
                    }
                }
                VerticalLayout {
                    vertical-stretch: 0;
                    Text { text: "Password"; }
                    password := LineEdit {
                        input-type: InputType.password;
                        text <=> root.password;
                        accepted => { root.perform("auth.signup", "form"); }
                    }
                }
                VerticalLayout {
                    vertical-stretch: 0;
                    Text { text: "Confirm password"; }
                    confirm := LineEdit {
                        input-type: InputType.password;
                        text <=> root.confirm;
                        accepted => { root.perform("auth.signup", "form"); }
                    }
                }
                terms := CheckBox {
                    vertical-stretch: 0;
                    text: "I accept the terms of service";
                    checked <=> root.acceptTerms;
                }
            }
            submit := Button {
                text: "Create account";
                primary: true;
                enabled: root.acceptTerms;
                clicked => { root.perform("auth.signup", "form"); }
            }
            HorizontalBox {
                signin := TouchArea {
                    clicked => { root.perform("nav.signin", "signin"); }
                    Text { text: "Already have an account? Sign in"; color: Palette.accent-background; }
                }
            }
        }
    }
}
