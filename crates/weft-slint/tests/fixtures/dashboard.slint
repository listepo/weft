import { GroupBox, Palette, VerticalBox } from "std-widgets.slint";

export component DashboardScreen inherits Window {
    title: "Team dashboard";
    in-out property <string> team-name;
    in-out property <string> updatedAt;
    in-out property <string> stats-velocity;
    in-out property <string> stats-bugs;
    in-out property <string> stats-incidents;
    in-out property <string> backupStatus;
    in-out property <string> statusUrl;
    callback perform(string, string);

    dashboard := VerticalBox {
        alignment: LayoutAlignment.start;
        header := HorizontalLayout {
            spacing: 16px;
            title := Text {
                text: root.team-name;
                font-size: 32px;
                font-weight: 700;
            }
            updated := Text {
                text: root.updatedAt;
            }
        }
        stats := GridLayout {
            spacing: 24px;
            velocity := GroupBox {
                row: 0;
                col: 0;
                title: "Velocity";
                VerticalBox {
                    velocity-title := Text {
                        text: "Velocity";
                        font-size: 24px;
                        font-weight: 700;
                    }
                    velocity-value := Text {
                        text: root.stats-velocity;
                    }
                }
            }
            bugs := GroupBox {
                row: 0;
                col: 1;
                title: "Open bugs";
                VerticalBox {
                    bugs-title := Text {
                        text: "Open bugs";
                        font-size: 24px;
                        font-weight: 700;
                    }
                    bugs-value := Text {
                        text: root.stats-bugs;
                    }
                }
            }
            incidents := GroupBox {
                row: 0;
                col: 2;
                title: "Incidents";
                VerticalBox {
                    incidents-title := Text {
                        text: "Incidents";
                        font-size: 24px;
                        font-weight: 700;
                    }
                    incidents-value := Text {
                        text: root.stats-incidents;
                    }
                }
            }
        }
        notices := VerticalLayout {
            spacing: 8px;
            release := VerticalLayout {
                Text { text: "Release 2.4 ships on Friday."; }
            }
            backup := VerticalLayout {
                Text { text: root.backupStatus; }
            }
            quota := VerticalLayout {
                quota-text := Text {
                    text: "Storage is 90% full.";
                }
                quota-link := TouchArea {
                    Text { text: "Manage storage"; color: Palette.accent-background; }
                }
            }
        }
        footer := HorizontalLayout {
            spacing: 16px;
            owner := Text {
                text: "Owned by the platform team";
            }
            footer-links := HorizontalLayout {
                spacing: 16px;
                docs := TouchArea {
                    Text { text: "Docs"; color: Palette.accent-background; }
                }
                status := TouchArea {
                    Text { text: "Status page"; color: Palette.accent-background; }
                }
            }
        }
    }
}
