<?xml version="1.0" encoding="utf-8"?>
<!-- weft:source winui name=ExampleList namespace=WeftScreens
<screen id="root" label="Todos" weft="0.1">
  <list id="todos" ordered="false" state="ready">
    <each id="todo-each" as="todo" in="{$.todos}">
      <item id="todo-item">
        <text id="todo-title" text="{$todo.title}"/>
      </item>
    </each>
    <slot name="empty">
      <text id="todos-empty" tone="muted">Nothing to do.</text>
    </slot>
  </list>
</screen>
-->
<Page x:Class="WeftScreens.ExampleListPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="root" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Todos">
            <ListView AutomationProperties.AutomationId="todos" SelectionMode="None" weft:Props.Ordered="False" ItemsSource="{x:Bind ViewModel.todos, Mode=OneWay}" weft:Each.Id="todo-each" weft:Each.As="todo" weft:Props.State="ready">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="weft:ExampleListTodosItem">
                        <ContentControl AutomationProperties.AutomationId="todo-item" AutomationProperties.LocalizedControlType="list item">
                            <StackPanel>
                                <TextBlock AutomationProperties.AutomationId="todo-title" TextWrapping="Wrap" Text="{x:Bind title, Mode=OneWay}" />
                            </StackPanel>
                        </ContentControl>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.Footer>
                    <StackPanel weft:Slot.Name="empty" Visibility="{x:Bind weft:Weft.Empty(ViewModel.todos.Count), Mode=OneWay}">
                        <TextBlock AutomationProperties.AutomationId="todos-empty" TextWrapping="Wrap" Text="Nothing to do." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ListView.Footer>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
