<Page x:Class="WeftScreens.CorpusTodoListPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="todos" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Tasks">
            <TextBlock AutomationProperties.AutomationId="title" Style="{StaticResource TitleLargeTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" Text="Tasks" />
            <StackPanel AutomationProperties.AutomationId="add-form" AutomationProperties.LandmarkType="Form" weft:On.Submit="{x:Bind ViewModel.todo_addCommand}">
                <StackPanel AutomationProperties.AutomationId="add-row" Spacing="{StaticResource Weft.space.sm}" Orientation="Horizontal">
                    <TextBox AutomationProperties.AutomationId="draft" Text="{x:Bind ViewModel.draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="New task" VerticalAlignment="Center" />
                    <Button AutomationProperties.AutomationId="add" Content="Add" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind weft:Weft.Truthy(ViewModel.draft), Mode=OneWay}" weft:On.Submit="{x:Bind ViewModel.todo_addCommand}" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
            <ListView AutomationProperties.AutomationId="list" SelectionMode="None" ItemsSource="{x:Bind ViewModel.todos, Mode=OneWay}" weft:Each.Id="todo-each" weft:Each.As="todo">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="weft:CorpusTodoListTodosItem">
                        <ContentControl AutomationProperties.AutomationId="todo" AutomationProperties.LocalizedControlType="list item">
                            <StackPanel>
                                <CheckBox AutomationProperties.AutomationId="todo-done" IsChecked="{x:Bind done, Mode=TwoWay}" Content="{x:Bind title, Mode=OneWay}" />
                                <Button AutomationProperties.AutomationId="todo-remove" Content="Remove" weft:On.Press="{x:Bind WeftRoot.todo_removeCommand}" />
                            </StackPanel>
                        </ContentControl>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock AutomationProperties.AutomationId="remaining" TextWrapping="Wrap" Text="{x:Bind ViewModel.remainingLabel, Mode=OneWay}" />
        </StackPanel>
    </ScrollViewer>
</Page>
