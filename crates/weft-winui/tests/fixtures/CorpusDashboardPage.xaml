<Page x:Class="WeftScreens.CorpusDashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="dashboard" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Team dashboard" weft:Props.State="ready">
            <Grid AutomationProperties.AutomationId="header" ColumnSpacing="{StaticResource Weft.space.md}" weft:Props.Wrap="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock AutomationProperties.AutomationId="title" Style="{StaticResource TitleLargeTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" Text="{x:Bind ViewModel.team.name, Mode=OneWay}" VerticalAlignment="Center" />
                <TextBlock AutomationProperties.AutomationId="updated" TextWrapping="Wrap" Text="{x:Bind ViewModel.updatedAt, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Grid.Column="2" />
            </Grid>
            <weft:ColumnsPanel AutomationProperties.AutomationId="stats" Columns="3" MinColumnWidth="{StaticResource Weft.size.sm}" Spacing="{StaticResource Weft.space.lg}">
                <StackPanel AutomationProperties.AutomationId="velocity" AutomationProperties.LandmarkType="Custom" AutomationProperties.LocalizedLandmarkType="region" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Spacing="12" AutomationProperties.Name="Velocity">
                    <StackPanel weft:Slot.Name="header">
                        <TextBlock AutomationProperties.AutomationId="velocity-title" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" Text="Velocity" />
                    </StackPanel>
                    <TextBlock AutomationProperties.AutomationId="velocity-value" TextWrapping="Wrap" Text="{x:Bind ViewModel.stats.velocity, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                </StackPanel>
                <StackPanel AutomationProperties.AutomationId="bugs" AutomationProperties.LandmarkType="Custom" AutomationProperties.LocalizedLandmarkType="region" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Spacing="12" AutomationProperties.Name="Open bugs">
                    <StackPanel weft:Slot.Name="header">
                        <TextBlock AutomationProperties.AutomationId="bugs-title" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" Text="Open bugs" />
                    </StackPanel>
                    <TextBlock AutomationProperties.AutomationId="bugs-value" TextWrapping="Wrap" Text="{x:Bind ViewModel.stats.bugs, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                </StackPanel>
                <StackPanel AutomationProperties.AutomationId="incidents" AutomationProperties.LandmarkType="Custom" AutomationProperties.LocalizedLandmarkType="region" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Spacing="12" AutomationProperties.Name="Incidents">
                    <StackPanel weft:Slot.Name="header">
                        <TextBlock AutomationProperties.AutomationId="incidents-title" Style="{StaticResource TitleTextBlockStyle}" AutomationProperties.HeadingLevel="Level2" Text="Incidents" />
                    </StackPanel>
                    <TextBlock AutomationProperties.AutomationId="incidents-value" TextWrapping="Wrap" Text="{x:Bind ViewModel.stats.incidents, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </weft:ColumnsPanel>
            <StackPanel AutomationProperties.AutomationId="notices" Orientation="Vertical" Spacing="{StaticResource Weft.space.sm}" MaxWidth="{StaticResource Weft.size.lg}">
                <InfoBar AutomationProperties.AutomationId="release" IsOpen="True" IsClosable="False" Severity="Informational" Message="Release 2.4 ships on Friday." />
                <InfoBar AutomationProperties.AutomationId="backup" IsOpen="True" IsClosable="False" Severity="Success" Message="{x:Bind ViewModel.backupStatus, Mode=OneWay}" />
                <InfoBar AutomationProperties.AutomationId="quota" IsOpen="True" IsClosable="False" Severity="Warning">
                    <StackPanel>
                        <TextBlock AutomationProperties.AutomationId="quota-text" TextWrapping="Wrap" Text="Storage is 90% full." />
                        <HyperlinkButton AutomationProperties.AutomationId="quota-link" Content="Manage storage" NavigateUri="https://example.com/storage" />
                    </StackPanel>
                </InfoBar>
            </StackPanel>
            <Grid AutomationProperties.AutomationId="footer" ColumnSpacing="{StaticResource Weft.space.md}" weft:Props.Wrap="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock AutomationProperties.AutomationId="owner" TextWrapping="Wrap" Text="Owned by the platform team" VerticalAlignment="Bottom" />
                <StackPanel AutomationProperties.AutomationId="footer-links" Orientation="Horizontal" Spacing="{StaticResource Weft.space.md}" VerticalAlignment="Bottom" Grid.Column="2">
                    <HyperlinkButton AutomationProperties.AutomationId="docs" Content="Docs" weft:Props.Href="/docs" VerticalAlignment="Top" />
                    <HyperlinkButton AutomationProperties.AutomationId="status" Content="Status page" NavigateUri="{x:Bind weft:Weft.Link(ViewModel.statusUrl), Mode=OneWay}" VerticalAlignment="Top" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
