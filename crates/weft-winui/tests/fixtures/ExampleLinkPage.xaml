<?xml version="1.0" encoding="utf-8"?>
<!-- weft:source winui name=ExampleLink namespace=WeftScreens
<screen id="root" label="Help" weft="0.1">
  <link id="docs" href="https://example.com/help">Read the help center</link>
  <link id="reset" on-press="nav.reset">Forgot password?</link>
</screen>
-->
<Page x:Class="WeftScreens.ExampleLinkPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="root" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Help">
            <HyperlinkButton AutomationProperties.AutomationId="docs" Content="Read the help center" NavigateUri="https://example.com/help" />
            <HyperlinkButton AutomationProperties.AutomationId="reset" Content="Forgot password?" weft:On.Press="{x:Bind ViewModel.nav_resetCommand}" />
        </StackPanel>
    </ScrollViewer>
</Page>
