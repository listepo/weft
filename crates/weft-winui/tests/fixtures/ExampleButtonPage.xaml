<?xml version="1.0" encoding="utf-8"?>
<!-- weft:source winui name=ExampleButton namespace=WeftScreens
<screen id="root" label="Checkout" weft="0.1">
  <button id="pay" disabled="{!$.cartReady}" state="idle" variant="primary" on-press="order.pay">Pay now</button>
</screen>
-->
<Page x:Class="WeftScreens.ExampleButtonPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="root" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Checkout">
            <Button AutomationProperties.AutomationId="pay" Content="Pay now" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind weft:Weft.Truthy(ViewModel.cartReady), Mode=OneWay}" weft:Props.State="idle" weft:On.Press="{x:Bind ViewModel.order_payCommandMissing}" />
        </StackPanel>
    </ScrollViewer>
</Page>
