<?xml version="1.0" encoding="utf-8"?>
<!-- weft:source winui name=ExampleCombobox namespace=WeftScreens
<screen id="root" label="Shipping" weft="0.1">
  <combobox id="city" disabled="false" label="City" placeholder="Type a city" value="{$.city}" on-change="shipping.update">
    <option id="city-lisbon" value="Lisbon">Portugal</option>
    <option id="city-madrid" value="Madrid">Spain</option>
  </combobox>
</screen>
-->
<Page x:Class="WeftScreens.ExampleComboboxPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="root" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Shipping">
            <ComboBox AutomationProperties.AutomationId="city" IsEditable="True" PlaceholderText="Type a city" weft:Choice.Value="{x:Bind ViewModel.city, Mode=TwoWay}" IsEnabled="True" Header="City" weft:On.Change="{x:Bind ViewModel.shipping_updateCommand}">
                <ComboBoxItem AutomationProperties.AutomationId="city-lisbon" Content="Lisbon" ToolTipService.ToolTip="Portugal" Tag="Lisbon" />
                <ComboBoxItem AutomationProperties.AutomationId="city-madrid" Content="Madrid" ToolTipService.ToolTip="Spain" Tag="Madrid" />
            </ComboBox>
        </StackPanel>
    </ScrollViewer>
</Page>
