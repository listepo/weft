<?xml version="1.0" encoding="utf-8"?>
<!-- weft:source winui name=ExampleRadio namespace=WeftScreens
<screen id="root" label="Delivery" weft="0.1">
  <radio-group id="speed" label="Delivery speed" value="{$.speed}">
    <radio id="speed-std" disabled="false" value="standard">Standard</radio>
    <radio id="speed-fast" disabled="{!$.expressAvailable}" value="express">Express</radio>
  </radio-group>
</screen>
-->
<Page x:Class="WeftScreens.ExampleRadioPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="root" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Delivery">
            <RadioButtons AutomationProperties.AutomationId="speed" weft:Choice.Value="{x:Bind ViewModel.speed, Mode=TwoWay}" Header="Delivery speed">
                <RadioButton AutomationProperties.AutomationId="speed-std" Content="Standard" Tag="standard" IsEnabled="True" />
                <RadioButton AutomationProperties.AutomationId="speed-fast" Content="Express" Tag="express" IsEnabled="{x:Bind weft:Weft.Truthy(ViewModel.expressAvailable), Mode=OneWay}" />
            </RadioButtons>
        </StackPanel>
    </ScrollViewer>
</Page>
