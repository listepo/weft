<Page x:Class="WeftScreens.CorpusLoginPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="login" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Sign in">
            <StackPanel AutomationProperties.AutomationId="form" AutomationProperties.LandmarkType="Form" weft:Props.State="idle" weft:On.Submit="{x:Bind ViewModel.auth_submitCommand}">
                <TextBlock AutomationProperties.AutomationId="title" Style="{StaticResource TitleLargeTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" Text="Sign in" />
                <StackPanel AutomationProperties.AutomationId="fields" Spacing="{StaticResource Weft.space.md}">
                    <TextBox AutomationProperties.AutomationId="email" Text="{x:Bind ViewModel.email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="EmailSmtpAddress" AutomationProperties.IsRequiredForForm="True" Header="Email" />
                    <PasswordBox AutomationProperties.AutomationId="password" Password="{x:Bind ViewModel.password, Mode=TwoWay}" AutomationProperties.IsRequiredForForm="True" Header="Password" />
                </StackPanel>
                <Button AutomationProperties.AutomationId="submit" Content="Sign in" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind weft:Weft.Truthy(ViewModel.email), Mode=OneWay}" weft:On.Submit="{x:Bind ViewModel.auth_submitCommand}" />
                <StackPanel Orientation="Horizontal" weft:Slot.Name="footer">
                    <HyperlinkButton AutomationProperties.AutomationId="reset" Content="Forgot password?" weft:On.Press="{x:Bind ViewModel.nav_resetCommand}" />
                    <HyperlinkButton AutomationProperties.AutomationId="signup" Content="Create an account" weft:On.Press="{x:Bind ViewModel.nav_signupCommand}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
