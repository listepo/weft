<Page x:Class="WeftScreens.CorpusWizardStepPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="wizard" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Setup wizard">
            <TextBlock AutomationProperties.AutomationId="title" Style="{StaticResource TitleLargeTextBlockStyle}" AutomationProperties.HeadingLevel="Level1" Text="Choose a plan" />
            <TextBlock AutomationProperties.AutomationId="progress" TextWrapping="Wrap" Text="{x:Bind ViewModel.progress, Mode=OneWay}" />
            <RadioButtons AutomationProperties.AutomationId="plan" weft:Choice.Value="{x:Bind ViewModel.plan, Mode=TwoWay}" Header="Plan">
                <RadioButton AutomationProperties.AutomationId="plan-free" Content="Free" Tag="free" />
                <RadioButton AutomationProperties.AutomationId="plan-pro" Content="Pro" Tag="pro" />
                <RadioButton AutomationProperties.AutomationId="plan-team" Content="Team" Tag="team" />
            </RadioButtons>
            <StackPanel AutomationProperties.AutomationId="nav" Orientation="Horizontal" Spacing="{StaticResource Weft.space.sm}">
                <Button AutomationProperties.AutomationId="back" Content="Back" weft:On.Press="{x:Bind ViewModel.wizard_backCommand}" VerticalAlignment="Center" />
                <Button AutomationProperties.AutomationId="next" Content="Next" Style="{StaticResource AccentButtonStyle}" IsEnabled="{x:Bind weft:Weft.Truthy(ViewModel.plan), Mode=OneWay}" weft:On.Press="{x:Bind ViewModel.wizard_nextCommand}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
