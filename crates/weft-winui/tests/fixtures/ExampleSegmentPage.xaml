<?xml version="1.0" encoding="utf-8"?>
<!-- weft:source winui name=ExampleSegment namespace=WeftScreens
<screen id="root" label="Sort" weft="0.1">
  <segmented-control id="order" label="Order" value="{$.order}">
    <segment id="order-new" disabled="false" value="new">Newest</segment>
    <segment id="order-top" value="top">Top</segment>
  </segmented-control>
</screen>
-->
<Page x:Class="WeftScreens.ExampleSegmentPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="root" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Sort">
            <SelectorBar AutomationProperties.AutomationId="order" weft:Choice.Value="{x:Bind ViewModel.order, Mode=TwoWay}" AutomationProperties.Name="Order">
                <SelectorBarItem AutomationProperties.AutomationId="order-new" Text="Newest" Tag="new" IsEnabled="True" />
                <SelectorBarItem AutomationProperties.AutomationId="order-top" Text="Top" Tag="top" />
            </SelectorBar>
        </StackPanel>
    </ScrollViewer>
</Page>
