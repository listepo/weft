<?xml version="1.0" encoding="utf-8"?>
<!-- weft:source winui name=ExampleImage namespace=WeftScreens
<screen id="root" label="Profile" weft="0.1">
  <image id="avatar" label="Profile photo of the user" src="{$.user.avatar}"/>
</screen>
-->
<Page x:Class="WeftScreens.ExampleImagePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="root" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Profile">
            <Image AutomationProperties.AutomationId="avatar" Source="{x:Bind weft:Weft.Image(ViewModel.user.avatar), Mode=OneWay}" AutomationProperties.Name="Profile photo of the user" />
        </StackPanel>
    </ScrollViewer>
</Page>
