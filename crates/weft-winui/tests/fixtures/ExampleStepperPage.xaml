<?xml version="1.0" encoding="utf-8"?>
<!-- weft:source winui name=ExampleStepper namespace=WeftScreens
<screen id="root" label="Order" weft="0.1">
  <stepper id="quantity" disabled="false" label="Quantity" max="10" min="1" step="1" value="{$.quantity}" on-change="order.update"/>
</screen>
-->
<Page x:Class="WeftScreens.ExampleStepperPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="root" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Order">
            <NumberBox AutomationProperties.AutomationId="quantity" SpinButtonPlacementMode="Inline" Minimum="1" Maximum="10" SmallChange="1" Value="{x:Bind ViewModel.quantity, Mode=TwoWay}" IsEnabled="True" Header="Quantity" weft:On.Change="{x:Bind ViewModel.order_updateCommand}" />
        </StackPanel>
    </ScrollViewer>
</Page>
