<?xml version="1.0" encoding="utf-8"?>
<!-- weft:source winui name=ExampleSelect namespace=WeftScreens
<screen id="root" label="Locale" weft="0.1">
  <select id="country" disabled="false" label="Country" value="{$.country}" on-change="profile.update">
    <option id="c-pt" value="pt">Portugal</option>
    <option id="c-es" value="es">Spain</option>
  </select>
</screen>
-->
<Page x:Class="WeftScreens.ExampleSelectPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="root" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Locale">
            <ComboBox AutomationProperties.AutomationId="country" weft:Choice.Value="{x:Bind ViewModel.country, Mode=TwoWay}" IsEnabled="True" Header="Country" weft:On.Change="{x:Bind ViewModel.profile_updateCommand}">
                <ComboBoxItem AutomationProperties.AutomationId="c-pt" Content="Portugal" Tag="pt" />
                <ComboBoxItem AutomationProperties.AutomationId="c-es" Content="Spain" Tag="es" />
            </ComboBox>
        </StackPanel>
    </ScrollViewer>
</Page>
