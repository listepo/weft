<Page x:Class="WeftScreens.CorpusInboxPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="inbox" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Inbox" weft:Props.State="loading">
            <TabView AutomationProperties.AutomationId="folders" IsAddTabButtonVisible="False" weft:Choice.Value="{x:Bind ViewModel.folder, Mode=TwoWay}" weft:On.Change="{x:Bind ViewModel.inbox_folderCommand}">
                <TabViewItem AutomationProperties.AutomationId="tab-inbox" IsClosable="False" Tag="tab-inbox" Header="Inbox">
                    <StackPanel>
                        <ListView AutomationProperties.AutomationId="messages" SelectionMode="None" weft:Props.Ordered="True" ItemsSource="{x:Bind ViewModel.messages, Mode=OneWay}" weft:Each.Id="message-each" weft:Each.As="message" weft:Props.State="ready">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="weft:CorpusInboxMessagesItem">
                                    <ContentControl AutomationProperties.AutomationId="message" Content="{x:Bind subject, Mode=OneWay}" weft:On.Press="{x:Bind WeftRoot.inbox_openCommand}" AutomationProperties.LocalizedControlType="list item" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                            <ListView.Footer>
                                <StackPanel weft:Slot.Name="empty" Visibility="{x:Bind weft:Weft.Empty(ViewModel.messages.Count), Mode=OneWay}">
                                    <TextBlock AutomationProperties.AutomationId="no-messages" TextWrapping="Wrap" Text="No messages." />
                                </StackPanel>
                            </ListView.Footer>
                        </ListView>
                    </StackPanel>
                </TabViewItem>
                <TabViewItem AutomationProperties.AutomationId="tab-drafts" IsClosable="False" Tag="tab-drafts" Header="{x:Bind ViewModel.labels.drafts, Mode=OneWay}">
                    <StackPanel>
                        <ListView AutomationProperties.AutomationId="drafts" SelectionMode="None" weft:Props.State="empty">
                            <ListView.Footer>
                                <StackPanel weft:Slot.Name="empty">
                                    <StackPanel AutomationProperties.AutomationId="drafts-empty" Spacing="{StaticResource Weft.space.sm}" Orientation="Vertical">
                                        <TextBlock AutomationProperties.AutomationId="no-drafts" TextWrapping="Wrap" Text="No drafts." HorizontalAlignment="Center" />
                                        <TextBlock AutomationProperties.AutomationId="no-drafts-hint" TextWrapping="Wrap" Text="Messages you start appear here." HorizontalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </ListView.Footer>
                        </ListView>
                    </StackPanel>
                </TabViewItem>
                <TabViewItem AutomationProperties.AutomationId="tab-sent" IsClosable="False" Tag="tab-sent" Header="Sent">
                    <StackPanel>
                        <ListView AutomationProperties.AutomationId="sent" SelectionMode="None" weft:Props.State="loading">
                            <ListViewItem AutomationProperties.AutomationId="sent-loading" Content="Loading…" />
                        </ListView>
                    </StackPanel>
                </TabViewItem>
            </TabView>
            <DropDownButton AutomationProperties.AutomationId="message-actions" Content="Message actions" AutomationProperties.Name="Message actions">
                <DropDownButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem AutomationProperties.AutomationId="archive" Text="{x:Bind ViewModel.labels.archive, Mode=OneWay}" weft:On.Press="{x:Bind ViewModel.inbox_archiveCommand}" />
                        <MenuFlyoutItem AutomationProperties.AutomationId="delete" Text="Delete" IsEnabled="{x:Bind weft:Weft.Truthy(ViewModel.selection), Mode=OneWay}" weft:On.Press="{x:Bind ViewModel.inbox_deleteCommand}" />
                    </MenuFlyout>
                </DropDownButton.Flyout>
            </DropDownButton>
            <ContentDialog AutomationProperties.AutomationId="compose" weft:Dialog.IsOpen="{x:Bind ViewModel.composing, Mode=TwoWay}" weft:Props.Modal="False" AutomationProperties.Name="New message" weft:On.Close="{x:Bind ViewModel.inbox_closeComposeCommand}">
                <StackPanel>
                    <StackPanel AutomationProperties.AutomationId="compose-form" AutomationProperties.LandmarkType="Form" weft:Props.State="submitting" weft:On.Submit="{x:Bind ViewModel.inbox_sendCommand}">
                        <TextBox AutomationProperties.AutomationId="to" Text="{x:Bind ViewModel.draft.to, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" InputScope="EmailSmtpAddress" Header="To" />
                        <TextBox AutomationProperties.AutomationId="body" Text="{x:Bind ViewModel.draft.body, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Header="Message" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" weft:Slot.Name="actions">
                        <Button AutomationProperties.AutomationId="send" Content="Send" Style="{StaticResource AccentButtonStyle}" weft:On.Press="{x:Bind ViewModel.inbox_sendCommand}" />
                    </StackPanel>
                </StackPanel>
            </ContentDialog>
        </StackPanel>
    </ScrollViewer>
</Page>
