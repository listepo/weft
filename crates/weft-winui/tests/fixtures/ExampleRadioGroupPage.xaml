<?xml version="1.0" encoding="utf-8"?>
<!-- weft:source winui name=ExampleRadioGroup namespace=WeftScreens
<screen id="root" label="Plan" weft="0.1">
  <radio-group id="plan" label="Plan" value="{$.plan}" on-change="plan.choose">
    <radio id="plan-free" value="free">Free</radio>
    <radio id="plan-pro" value="pro">Pro</radio>
  </radio-group>
</screen>
-->
<Page x:Class="WeftScreens.ExampleRadioGroupPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:weft="using:WeftScreens">
    <ScrollViewer>
        <StackPanel AutomationProperties.AutomationId="root" AutomationProperties.LandmarkType="Main" AutomationProperties.Name="Plan">
            <RadioButtons AutomationProperties.AutomationId="plan" weft:Choice.Value="{x:Bind ViewModel.plan, Mode=TwoWay}" Header="Plan" weft:On.Change="{x:Bind ViewModel.plan_chooseCommand}">
                <RadioButton AutomationProperties.AutomationId="plan-free" Content="Free" Tag="free" />
                <RadioButton AutomationProperties.AutomationId="plan-pro" Content="Pro" Tag="pro" />
            </RadioButtons>
        </StackPanel>
    </ScrollViewer>
</Page>
