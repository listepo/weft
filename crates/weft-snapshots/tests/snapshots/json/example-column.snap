  "root": {
    "kind": "screen",
    "id": "root",
    "props": {
      "label": "Users"
    },
    "children": [
      {
        "kind": "table",
        "id": "users",
        "props": {
          "label": "Users"
        },
        "children": [
          {
            "kind": "column",
            "id": "col-name",
            "props": {
              "sort": "ascending"
