---
source: crates/weft-snapshots/tests/interop.rs
description: corpus-confirm-dialog as a2ui
---
[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "files",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json"
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "files",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": [
            "title",
            "delete-file",
            "confirm"
          ],
          "accessibility": {
            "label": "File"
          }
        },
        {
          "id": "title",
          "component": "Text",
          "text": "Quarterly report",
          "variant": "h1"
        },
        {
          "id": "delete-file",
          "component": "Button",
          "child": "delete-file-label",
          "variant": "default",
          "action": {
            "event": {
              "name": "dialog.open"
            }
          }
        },
        {
          "id": "delete-file-label",
          "component": "Text",
          "text": "Delete file"
        },
        {
          "id": "confirm",
          "component": "Modal",
          "trigger": "confirm-trigger",
          "content": "column",
          "accessibility": {
            "label": "Delete file?"
          }
        },
        {
          "id": "warning",
          "component": "Text",
          "text": "This cannot be undone."
        },
        {
          "id": "filename",
          "component": "Text",
          "text": {
            "path": "/file/name"
          }
        },
        {
          "id": "cancel",
          "component": "Button",
          "child": "cancel-label",
          "variant": "default",
          "action": {
            "event": {
              "name": "dialog.close"
            }
          }
        },
        {
          "id": "cancel-label",
          "component": "Text",
          "text": "Cancel"
        },
        {
          "id": "confirm-delete",
          "component": "Button",
          "child": "confirm-delete-label",
          "variant": "default",
          "action": {
            "event": {
              "name": "file.delete"
            }
          }
        },
        {
          "id": "confirm-delete-label",
          "component": "Text",
          "text": "Delete"
        },
        {
          "id": "column",
          "component": "Column",
          "children": [
            "warning",
            "filename",
            "cancel",
            "confirm-delete"
          ]
        },
        {
          "id": "confirm-trigger-label",
          "component": "Text",
          "text": "Delete file?"
        },
        {
          "id": "confirm-trigger",
          "component": "Button",
          "child": "confirm-trigger-label",
          "action": {
            "event": {
              "name": "confirm.open"
            }
          }
        }
      ]
    }
  }
]
