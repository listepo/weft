---
source: crates/weft-snapshots/tests/interop.rs
description: corpus-todo-list as a2ui
---
[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "todos",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json"
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "todos",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": [
            "title",
            "add-form",
            "list",
            "remaining"
          ],
          "accessibility": {
            "label": "Tasks"
          }
        },
        {
          "id": "title",
          "component": "Text",
          "text": "Tasks",
          "variant": "h1"
        },
        {
          "id": "add-form",
          "component": "Column",
          "children": [
            "add-row"
          ]
        },
        {
          "id": "add-row",
          "component": "Row",
          "children": [
            "draft",
            "add"
          ]
        },
        {
          "id": "draft",
          "component": "TextField",
          "label": "New task",
          "variant": "shortText",
          "value": {
            "path": "/draft"
          }
        },
        {
          "id": "add",
          "component": "Button",
          "child": "add-label",
          "variant": "primary",
          "action": {
            "event": {
              "name": "todo.add"
            }
          },
          "checks": [
            {
              "condition": {
                "call": "required",
                "args": {
                  "value": {
                    "path": "/draft"
                  }
                }
              },
              "message": "Not available"
            }
          ]
        },
        {
          "id": "add-label",
          "component": "Text",
          "text": "Add"
        },
        {
          "id": "list",
          "component": "List",
          "children": {
            "componentId": "column",
            "path": "/todos"
          }
        },
        {
          "id": "todo-done",
          "component": "CheckBox",
          "label": {
            "path": "title"
          },
          "value": {
            "path": "done"
          }
        },
        {
          "id": "todo-remove",
          "component": "Button",
          "child": "todo-remove-label",
          "variant": "default",
          "action": {
            "event": {
              "name": "todo.remove"
            }
          }
        },
        {
          "id": "todo-remove-label",
          "component": "Text",
          "text": "Remove"
        },
        {
          "id": "column",
          "component": "Column",
          "children": [
            "todo-done",
            "todo-remove"
          ]
        },
        {
          "id": "remaining",
          "component": "Text",
          "text": {
            "path": "/remainingLabel"
          }
        }
      ]
    }
  }
]
