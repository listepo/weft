---
source: crates/weft-snapshots/tests/snapshots.rs
description: corpus-confirm-dialog as html
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>File</title>
<style>
:root {
  --weft-space-xs: 4px;
  --weft-space-sm: 8px;
  --weft-space-md: 16px;
  --weft-space-lg: 24px;
  --weft-space-xl: 32px;
  --weft-radius-sm: 4px;
  --weft-radius-md: 8px;
  --weft-radius-pill: 999px;
  --weft-font-size-sm: 0.875rem;
  --weft-font-size-md: 1rem;
  --weft-font-size-lg: 1.25rem;
  --weft-font-size-xl: 1.75rem;
  --weft-color-white: #ffffff;
  --weft-color-ink: #1a1c21;
  --weft-color-blue-_root: #2563eb;
  --weft-color-red: #dc2626;
  --weft-color-action-primary: #2563eb;
  --weft-color-action-danger: #dc2626;
}
.weft-stack { display: flex; flex-direction: column; }
.weft-row { display: flex; flex-direction: row; }
.weft-grid { display: grid; }
[data-align="start"] { align-items: flex-start; }
[data-align="center"] { align-items: center; }
[data-align="end"] { align-items: flex-end; }
[data-align="stretch"] { align-items: stretch; }
[data-wrap] { flex-wrap: wrap; }
a { display: inline-block; }
[hidden] { display: none !important; }
</style>
</head>
<body>
<main data-weft-id="files" aria-label="File">
  <h1 data-weft-id="title">Quarterly report</h1>
  <button data-weft-id="delete-file" type="button" data-variant="danger" data-action="press:dialog.open">Delete file</button>
  <dialog data-weft-id="confirm" aria-label="Delete file?" aria-modal="true" data-bind="open:$.confirmOpen" data-action="close:dialog.close">
    <div data-weft-id="warning" data-weft-kind="text">This cannot be undone.</div>
    <div data-weft-id="filename" data-weft-kind="text" data-bind="text:$.file.name"></div>
    <footer data-weft-slot="actions">
      <button data-weft-id="cancel" type="button" data-action="press:dialog.close">Cancel</button><button data-weft-id="confirm-delete" type="button" data-variant="danger" data-action="press:file.delete">Delete</button>
    </footer>
  </dialog>
</main>
</body>
</html>
