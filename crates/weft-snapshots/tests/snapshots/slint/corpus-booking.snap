import { Button, ComboBox, HorizontalBox, LineEdit, RadioGroup, Slider, SpinBox, VerticalBox } from "std-widgets.slint";

export component BookingScreen inherits Window {
    title: "Book a trip";
    in-out property <string> trip-city;
    in-out property <string> trip-depart;
    in-out property <string> trip-checkin;
    in-out property <string> trip-reminder;
    in-out property <int> trip-guests;
    in-out property <float> trip-budget;
    in-out property <string> trip-cabin;
    in-out property <string> trip-colour;
    in-out property <[string]> cities;
    callback perform(string, string);

    booking := VerticalBox {
        alignment: LayoutAlignment.start;
        title := Text {
            text: "Book a trip";
            font-size: 32px;
            font-weight: 700;
        }
        trip := VerticalBox {
            VerticalLayout {
                Text { text: "Destination"; }
                city := ComboBox {
                    model: root.cities;
                    current-value <=> root.trip-city;
                    selected => { root.perform("trip.edit", "city"); }
                }
            }
            VerticalLayout {
                Text { text: "Departure"; }
                depart := LineEdit {
                    text <=> root.trip-depart;
                    edited => { root.perform("trip.edit", "depart"); }
                }
            }
            VerticalLayout {
                Text { text: "Check-in time"; }
                checkin := LineEdit {
                    text <=> root.trip-checkin;
                }
            }
            VerticalLayout {
                Text { text: "Reminder"; }
                reminder := LineEdit {
                    text <=> root.trip-reminder;
                }
            }
            VerticalLayout {
                Text { text: "Guests"; }
                guests := SpinBox {
                    minimum: 1;
                    maximum: 8;
                    value <=> root.trip-guests;
                    edited => { root.perform("trip.edit", "guests"); }
                }
            }
            VerticalLayout {
                Text { text: "Budget per night"; }
                budget := Slider {
                    minimum: 50;
                    maximum: 500;
                    value <=> root.trip-budget;
                    changed => { root.perform("trip.edit", "budget"); }
                }
            }
            cabin := RadioGroup {
                title: "Cabin";
                orientation: Orientation.horizontal;
                cabin-economy := RadioButton {
                    text: "Economy";
                    checked: root.trip-cabin == "economy";
                }
                cabin-business := RadioButton {
                    text: "Business";
                    checked: root.trip-cabin == "business";
                }
                cabin-first := RadioButton {
                    text: "First";
                    checked: root.trip-cabin == "first";
                }
                selected(picked) => { root.trip-cabin = picked == "Economy" ? "economy" : picked == "Business" ? "business" : "first"; root.perform("trip.edit", "cabin"); }
            }
            VerticalLayout {
                Text { text: "Trip colour"; }
                tag := LineEdit {
                    text <=> root.trip-colour;
                    edited => { root.perform("trip.edit", "tag"); }
                }
            }
            HorizontalBox {
                book := Button {
                    text: "Book";
                    primary: true;
                    clicked => { root.perform("trip.book", "trip"); }
                }
            }
        }
    }
}
