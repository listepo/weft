import { StandardTableView, VerticalBox } from "std-widgets.slint";

export component UsersScreen inherits Window {
    title: "Users";
    in-out property <[{ name: string, email: string, role: string, deleteLabel: string }]> users;
    callback perform(string, string);

    users := VerticalBox {
        alignment: LayoutAlignment.start;
        title := Text {
            text: "Users";
            font-size: 32px;
            font-weight: 700;
        }
        table := StandardTableView {
            accessible-label: "Users";
            columns: [{ title: "Name", sort-order: SortOrder.ascending }, { title: "Email" }, { title: "Role" }, { title: "Actions" }];
            sort-ascending(column) => { if column == 0 { root.perform("users.sort", "col-name"); } if column == 1 { root.perform("users.sort", "col-email"); } if column == 2 { root.perform("users.sort", "col-role"); } }
            sort-descending(column) => { if column == 0 { root.perform("users.sort", "col-name"); } if column == 1 { root.perform("users.sort", "col-email"); } if column == 2 { root.perform("users.sort", "col-role"); } }
        }
    }
}
