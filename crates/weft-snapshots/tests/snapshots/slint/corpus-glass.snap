import { Button, VerticalBox } from "std-widgets.slint";

export component GlassScreen inherits Window {
    title: "Glass";
    in-out property <string> title-data;
    callback perform(string, string);

    glass := VerticalBox {
        alignment: LayoutAlignment.start;
        card := VerticalLayout {
            spacing: 16px;
            title := Text {
                text: root.title-data;
                font-size: 24px;
                font-weight: 700;
            }
            body := Text {
                text: "The panel blurs what is behind it.";
            }
            close := Button {
                text: "Got it";
                primary: true;
                clicked => { root.perform("glass.close", "close"); }
            }
        }
        tiles := GridLayout {
            spacing: 8px;
            tile-light := Text {
                row: 0;
                col: 0;
                text: "Light";
            }
            tile-dark := Text {
                row: 0;
                col: 1;
                text: "Dark";
            }
        }
    }
}
