import { Button, LineEdit, ListView, Palette, VerticalBox } from "std-widgets.slint";

export component SearchScreen inherits Window {
    title: "Search";
    in-out property <string> query;
    in-out property <[{ title: string, snippet: string }]> results;
    callback perform(string, string);

    search := VerticalBox {
        alignment: LayoutAlignment.start;
        form := VerticalBox {
            bar := HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    Text { text: "Search"; }
                    query := LineEdit {
                        text <=> root.query;
                        accepted => { root.perform("search.run", "form"); }
                    }
                }
                go := Button {
                    text: "Search";
                    primary: true;
                    clicked => { root.perform("search.run", "form"); }
                }
            }
        }
        results := VerticalLayout {
            ListView {
                for result in root.results: VerticalLayout {
                    result-title := Text {
                        text: result.title;
                        font-size: 19px;
                        font-weight: 700;
                    }
                    result-snippet := Text {
                        text: result.snippet;
                    }
                    result-open := TouchArea {
                        clicked => { root.perform("results.open", "result-open"); }
                        Text { text: "Open"; color: Palette.accent-background; }
                    }
                }
            }
            if root.results.length == 0: VerticalLayout {
                empty := Text {
                    text: "No results found";
                }
            }
        }
    }
}
