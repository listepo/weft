import { Button, ComboBox, GroupBox, Switch, VerticalBox } from "std-widgets.slint";

export component SettingsScreen inherits Window {
    title: "Settings";
    in-out property <bool> emailAlerts;
    in-out property <bool> pushAlerts;
    in-out property <string> language;
    in-out property <bool> darkMode;
    in-out property <bool> dirty;
    callback perform(string, string);

    settings := VerticalBox {
        alignment: LayoutAlignment.start;
        title := Text {
            text: "Settings";
            font-size: 32px;
            font-weight: 700;
        }
        notifications := GroupBox {
            title: "Notifications";
            VerticalBox {
                notifications-title := Text {
                    text: "Notifications";
                    font-size: 24px;
                    font-weight: 700;
                }
                email-alerts := Switch {
                    text: "Email alerts";
                    checked <=> root.emailAlerts;
                }
                push-alerts := Switch {
                    text: "Push notifications";
                    checked <=> root.pushAlerts;
                }
            }
        }
        appearance := GroupBox {
            title: "Appearance";
            VerticalBox {
                appearance-title := Text {
                    text: "Appearance";
                    font-size: 24px;
                    font-weight: 700;
                }
                VerticalLayout {
                    Text { text: "Language"; }
                    language := ComboBox {
                        model: ["English", "Deutsch", "Français"];
                        current-index: root.language == "de" ? 1 : root.language == "fr" ? 2 : 0;
                        selected => { root.language = ["en", "de", "fr"][self.current-index]; }
                    }
                }
                dark-mode := Switch {
                    text: "Dark mode";
                    checked <=> root.darkMode;
                }
            }
        }
        save := Button {
            text: "Save changes";
            primary: true;
            enabled: root.dirty;
            clicked => { root.perform("settings.save", "save"); }
        }
    }
}
