import { Button, RadioGroup, VerticalBox } from "std-widgets.slint";

export component WizardScreen inherits Window {
    title: "Setup wizard";
    in-out property <string> progress;
    in-out property <string> plan;
    callback perform(string, string);

    wizard := VerticalBox {
        alignment: LayoutAlignment.start;
        title := Text {
            text: "Choose a plan";
            font-size: 32px;
            font-weight: 700;
        }
        progress := Text {
            text: root.progress;
        }
        plan := RadioGroup {
            title: "Plan";
            plan-free := RadioButton {
                text: "Free";
                checked: root.plan == "free";
            }
            plan-pro := RadioButton {
                text: "Pro";
                checked: root.plan == "pro";
            }
            plan-team := RadioButton {
                text: "Team";
                checked: root.plan == "team";
            }
            selected(picked) => { root.plan = picked == "Free" ? "free" : picked == "Pro" ? "pro" : "team"; }
        }
        nav := HorizontalLayout {
            spacing: 8px;
            back := Button {
                text: "Back";
                clicked => { root.perform("wizard.back", "back"); }
            }
            next := Button {
                text: "Next";
                primary: true;
                enabled: root.plan != "";
                clicked => { root.perform("wizard.next", "next"); }
            }
        }
    }
}
