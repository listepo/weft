import { Button, HorizontalBox, LineEdit, ListView, TabWidget, TextEdit, VerticalBox } from "std-widgets.slint";

export component InboxScreen inherits Window {
    title: "Inbox";
    in-out property <string> folder;
    in-out property <string> labels-drafts;
    in-out property <string> labels-archive;
    in-out property <bool> selection;
    in-out property <bool> composing;
    in-out property <string> draft-to;
    in-out property <string> draft-body;
    in-out property <[{ subject: string }]> messages;
    callback perform(string, string);

    message-actions := MenuBar {
        Menu {
            title: "Message actions";
            archive := MenuItem {
                title: root.labels-archive;
                activated => { root.perform("inbox.archive", "archive"); }
            }
            delete := MenuItem {
                title: "Delete";
                enabled: root.selection;
                activated => { root.perform("inbox.delete", "delete"); }
            }
        }
    }
    inbox := VerticalBox {
        alignment: LayoutAlignment.start;
        folders := TabWidget {
            current-index: root.folder == "tab-drafts" ? 1 : root.folder == "tab-sent" ? 2 : 0;
            changed current-index => { root.folder = ["tab-inbox", "tab-drafts", "tab-sent"][self.current-index]; root.perform("inbox.folder", "folders"); }
            tab-inbox := Tab {
                title: "Inbox";
                VerticalLayout {
                    messages := VerticalLayout {
                        ListView {
                            for message in root.messages: TouchArea {
                                clicked => { root.perform("inbox.open", "message"); }
                                Text { text: message.subject; }
                            }
                        }
                        if root.messages.length == 0: VerticalLayout {
                            no-messages := Text {
                                text: "No messages.";
                            }
                        }
                    }
                }
            }
            tab-drafts := Tab {
                title: root.labels-drafts;
                VerticalLayout {
                    drafts := VerticalLayout {
                        drafts-empty := VerticalLayout {
                            spacing: 8px;
                            no-drafts := Text {
                                text: "No drafts.";
                            }
                            no-drafts-hint := Text {
                                text: "Messages you start appear here.";
                            }
                        }
                    }
                }
            }
            tab-sent := Tab {
                title: "Sent";
                VerticalLayout {
                    sent := VerticalLayout {
                        sent-loading := Text {
                            text: "Loading…";
                        }
                    }
                }
            }
        }
        compose := PopupWindow {
            VerticalLayout {
                Text { text: "New message"; }
                compose-form := VerticalBox {
                    VerticalLayout {
                        Text { text: "To"; }
                        to := LineEdit {
                            text <=> root.draft-to;
                            accepted => { root.perform("inbox.send", "compose-form"); }
                        }
                    }
                    VerticalLayout {
                        Text { text: "Message"; }
                        body := TextEdit {
                            text <=> root.draft-body;
                        }
                    }
                }
                HorizontalBox {
                    send := Button {
                        text: "Send";
                        primary: true;
                        clicked => { root.perform("inbox.send", "send"); }
                    }
                }
            }
        }
    }
    init => {
        if root.composing { compose.show(); }
    }
    changed composing => { if root.composing { compose.show(); } else { compose.close(); } }
    property <bool> compose-is-open: compose.is-open;
    changed compose-is-open => { if !compose-is-open && root.composing { root.composing = false; root.perform("inbox.closeCompose", "compose"); } }
}
