// Generated by `weft swiftui-tokens` from the project's design tokens. Regenerate it
// instead of editing it: every screen of the project reads its values.

import SwiftUI

/// The project's design tokens: colours, sizes in points, fonts and timing.
struct WeftTokens: Sendable {
    var color = ColorTokens()
    var space = SpaceTokens()

    struct ColorTokens: Sendable {
        var surface = SurfaceTokens()
        var accent: Color = Color(.displayP3, red: 0.85, green: 0.47, blue: 0.02, opacity: 1)
        var brand: Color = Color(.sRGB, red: 0.851, green: 0.4667, blue: 0.0235, opacity: 1)

        struct SurfaceTokens: Sendable {
            var _root: Color = Color(.sRGB, red: 1, green: 1, blue: 1, opacity: 1)
            var raised: Color = Color(.sRGB, red: 0.96, green: 0.96, blue: 0.96, opacity: 0.9)
        }
    }

    struct SpaceTokens: Sendable {
        var md: CGFloat = 16
        var sm: CGFloat = 8
    }
}
