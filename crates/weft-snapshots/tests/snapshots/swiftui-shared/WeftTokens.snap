// Generated by `weft swiftui-tokens` from the project's design tokens. Regenerate it
// instead of editing it: every screen of the project reads its values.

import SwiftUI

/// The project's design tokens: colours, sizes in points, fonts and timing.
struct WeftTokens: Sendable {
    var color = ColorTokens()
    var font = FontTokens()
    var radius = RadiusTokens()
    var space = SpaceTokens()

    struct ColorTokens: Sendable {
        var action = ActionTokens()
        var blue = BlueTokens()
        var ink: Color = Color(.sRGB, red: 0.1, green: 0.11, blue: 0.13, opacity: 1)
        var red: Color = Color(.sRGB, red: 0.86, green: 0.15, blue: 0.15, opacity: 1)
        var white: Color = Color(.sRGB, red: 1, green: 1, blue: 1, opacity: 1)

        struct ActionTokens: Sendable {
            var danger: Color = Color(.sRGB, red: 0.86, green: 0.15, blue: 0.15, opacity: 1)
            var primary: Color = Color(.sRGB, red: 0.15, green: 0.39, blue: 0.92, opacity: 1)
        }

        struct BlueTokens: Sendable {
            var _root: Color = Color(.sRGB, red: 0.15, green: 0.39, blue: 0.92, opacity: 1)
        }
    }

    struct FontTokens: Sendable {
        var size = SizeTokens()

        struct SizeTokens: Sendable {
            var lg: CGFloat = 20
            var md: CGFloat = 16
            var sm: CGFloat = 14
            var xl: CGFloat = 28
        }
    }

    struct RadiusTokens: Sendable {
        var md: CGFloat = 8
        var pill: CGFloat = 999
        var sm: CGFloat = 4
    }

    struct SpaceTokens: Sendable {
        var lg: CGFloat = 24
        var md: CGFloat = 16
        var sm: CGFloat = 8
        var xl: CGFloat = 32
        var xs: CGFloat = 4
    }
}
