import { Fragment } from "react";

function _text(v) {
  if (typeof v === "string") return v;
  if (typeof v === "number") return Number.isFinite(v) ? String(v) : "";
  if (typeof v === "boolean") return String(v);
  return "";
}

function _list(v) {
  return Array.isArray(v) ? v : [];
}

function _keyed(list) {
  return list.map((x, i) => <Fragment key={i}>{x}</Fragment>);
}

export default function WeftScreen({ data, actions, onChange }) {
  return (
    <main data-weft-id="root" aria-label="Sizes">
      <label>
        <span aria-hidden="true">Size</span>
        {(() => {
          const _o = [
            ..._list(data?.sizes).flatMap((size, _i0) => [
              { value: size?.code, el: (
                <option data-weft-id={"size-option[" + _i0 + "]"} value={_text(size?.code)}>Size</option>
              ) },
            ]),
            { value: "other", el: (
              <option data-weft-id="size-other" value="other">Other</option>
            ) },
          ];
          return (
            <select data-weft-id="size" aria-label="Size" value={_text(data?.size)} onChange={(_e) => { const _c = _o.find((_x) => _text(_x.value) === _e.currentTarget.value); onChange?.("$.size", _c ? _c.value : _e.currentTarget.value); }}>
              {_keyed(_o.map((_x) => _x.el))}
            </select>
          );
        })()}
      </label>
    </main>
  );
}
