// Generated by `weft swiftui` from the Weft screen "account".
// Regenerate it from the .weft source, or edit it and read it back with
// `weft import-swiftui`; the `weft…` helpers at the end carry what SwiftUI cannot say.

import Observation
import SwiftUI

/// The data the screen reads and writes.
@Observable
final class AccountModel {
    var account: AccountData = AccountData()
    var errors: ErrorsData = ErrorsData()
    var labels: LabelsData = LabelsData()
    var saved: Bool = false

    struct AccountData: Hashable, Sendable {
        var name: String = ""
        var age: String = ""
        var locked: Bool = false
        var handle: String = ""
        var bio: String = ""
        var email: String = ""
        var newsletter: Bool = false
        var `public`: Bool = false
        var verified: Bool = false
        var plan: String = ""
        var language: String = ""
    }

    struct ErrorsData: Hashable, Sendable {
        var age: String = ""
    }

    struct LabelsData: Hashable, Sendable {
        var pro: String = ""
        var french: String = ""
        var cancel: String = ""
        var help: String = ""
    }
}

/// The host actions the screen names.
enum AccountAction: String, CaseIterable, Sendable {
    case accountSave = "account.save"
    case accountEdit = "account.edit"
    case accountCancel = "account.cancel"
}

/// What the host receives when the screen fires an action.
struct AccountEvent: Sendable, Equatable {
    var action: AccountAction
    /// The id of the element that fired it.
    var id: String
    /// The data path of the list item it came from, e.g. `$.todos.2`.
    var item: String?
}

/// The design tokens the screen uses, in points.
struct AccountTheme: Sendable {
}

struct AccountScreen: View {
    @Bindable var model: AccountModel
    var theme = AccountTheme()
    var perform: (AccountEvent) -> Void = { _ in }
    @Environment(\.openURL) private var openURL

    var body: some View {
        VStack(alignment: .leading) {
            Text("Edit account")
                .font(.largeTitle)
                .accessibilityHeading(.h1)
                .accessibilityAddTraits(.isHeader)
                .accessibilityIdentifier("title")
            Form {
                Section {
                    TextField("Full name", text: $model.account.name, prompt: Text("Ada Lovelace"))
                        .weftFieldType("text")
                        .onChange(of: model.account.name) { send(.accountEdit, "name") }
                        .weftProp("state", "valid")
                        .accessibilityIdentifier("name")
                    TextField("Age", text: $model.account.age)
                        .weftFieldType("number")
                        .weftProp("error", model.errors.age)
                        .weftProp("state", "invalid")
                        .accessibilityIdentifier("age")
                    TextField("Handle", text: $model.account.handle, prompt: Text("{handle}"))
                        .disabled(model.account.locked)
                        .accessibilityIdentifier("handle")
                    TextField("Bio", text: $model.account.bio, axis: .vertical)
                        .accessibilityIdentifier("bio")
                    TextField("Email", text: $model.account.email)
                        .weftFieldType("email")
                        .disabled(true)
                        .accessibilityIdentifier("email")
                    Toggle("Send me the newsletter", isOn: $model.account.newsletter)
                        .toggleStyle(WeftCheckboxStyle())
                        .onChange(of: model.account.newsletter) { send(.accountEdit, "newsletter") }
                        .accessibilityIdentifier("newsletter")
                    Toggle("Terms accepted", isOn: .constant(true))
                        .toggleStyle(WeftCheckboxStyle())
                        .disabled(true)
                        .accessibilityIdentifier("terms")
                    Toggle("Public profile", isOn: $model.account.`public`)
                        .toggleStyle(.switch)
                        .onChange(of: model.account.`public`) { send(.accountEdit, "public") }
                        .disabled(!model.account.verified)
                        .accessibilityIdentifier("public")
                    Picker("Plan", selection: $model.account.plan) {
                        Text("Free")
                            .tag("free")
                            .accessibilityIdentifier("plan-free")
                        Text(model.labels.pro)
                            .tag("pro")
                            .accessibilityIdentifier("plan-pro")
                        Text("Team")
                            .tag("team")
                            .disabled(true)
                            .accessibilityIdentifier("plan-team")
                    }
                    .pickerStyle(.inline)
                    .onChange(of: model.account.plan) { send(.accountEdit, "plan") }
                    .accessibilityIdentifier("plan")
                    Picker("Language", selection: $model.account.language) {
                        Text("English")
                            .tag("en")
                            .accessibilityIdentifier("language-en")
                        Text(model.labels.french)
                            .tag("fr")
                            .accessibilityIdentifier("language-fr")
                    }
                    .onChange(of: model.account.language) { send(.accountEdit, "language") }
                    .disabled(model.account.locked)
                    .accessibilityIdentifier("language")
                    Text("Internal note: never shown.")
                        .accessibilityIdentifier("internal")
                        .weftHidden(true)
                    GroupBox {
                        Text("Your changes were saved.")
                    }
                    .backgroundStyle(Color.green.opacity(0.15))
                    .accessibilityElement(children: .contain)
                    .accessibilityIdentifier("saved")
                    .weftHidden(!model.saved)
                } footer: {
                    Button {
                        submit("account-form")
                    } label: {
                        Text("Save")
                    }
                    .buttonStyle(.borderedProminent)
                    .weftProp("state", "busy")
                    .accessibilityIdentifier("save")
                    Button {
                        send(.accountCancel, "cancel")
                    } label: {
                        Text(model.labels.cancel)
                    }
                    .buttonStyle(.bordered)
                    .weftProp("state", "idle")
                    .accessibilityIdentifier("cancel")
                    Button {
                        openLink("https://example.com/help")
                    } label: {
                        Text(model.labels.help)
                    }
                    .buttonStyle(.borderless)
                    .accessibilityRemoveTraits(.isButton)
                    .accessibilityAddTraits(.isLink)
                    .accessibilityIdentifier("help")
                }
            }
            .onSubmit { send(.accountSave, "account-form") }
            .weftProp("state", "invalid")
            .accessibilityElement(children: .contain)
            .accessibilityLabel("Account")
            .accessibilityIdentifier("account-form")
        }
        .accessibilityElement(children: .contain)
        .accessibilityLabel("Edit account")
        .accessibilityIdentifier("account")
    }

    private func send(_ action: AccountAction, _ id: String, item: String? = nil) {
        perform(AccountEvent(action: action, id: id, item: item))
    }

    /// A submit button fires its form's submit action.
    private func submit(_ form: String) {
        switch form {
        case "account-form": send(.accountSave, "account-form")
        default: break
        }
    }

    private func openLink(_ href: String) {
        if let url = weftURL(href) { openURL(url) }
    }
}

#Preview {
    AccountScreen(model: AccountModel())
}

// MARK: - Weft helpers
// Weft semantics SwiftUI has no modifier for. `fileprivate`, so every generated screen carries
// its own copy and several screens can live in one module.

fileprivate extension View {
    /// A Weft attribute SwiftUI cannot express; kept so the screen imports back unchanged.
    func weftProp(_ name: String, _ value: String) -> some View { self }
    func weftProp(_ name: String, _ value: Bool) -> some View { self }
    func weftProp(_ name: String, _ value: Int) -> some View { self }
    func weftProp(_ name: String, _ value: Double) -> some View { self }
    /// Removes the view from layout and accessibility while `hidden` is true.
    func weftHidden(_ hidden: Bool) -> some View { modifier(WeftHidden(hidden: hidden)) }
    /// Names the `<each>` element the repeated content came from.
    func weftEach(_ id: String) -> some View { self }
    /// The keyboard a text field of this Weft `type` asks for.
    func weftFieldType(_ type: String) -> some View {
        #if os(iOS)
        switch type {
        case "email": return AnyView(self.keyboardType(.emailAddress).textInputAutocapitalization(.never))
        case "number": return AnyView(self.keyboardType(.decimalPad))
        case "search": return AnyView(self.submitLabel(.search))
        default: return AnyView(self)
        }
        #else
        return self
        #endif
    }
}

fileprivate struct WeftHidden: ViewModifier {
    let hidden: Bool
    func body(content: Content) -> some View {
        if !hidden { content }
    }
}

fileprivate struct WeftCheckboxStyle: ToggleStyle {
    func makeBody(configuration: Configuration) -> some View {
        Button { configuration.isOn.toggle() } label: {
            HStack {
                Image(systemName: configuration.isOn ? "checkmark.square.fill" : "square")
                configuration.label
            }
        }
        .buttonStyle(.plain)
        .accessibilityValue(configuration.isOn ? "checked" : "unchecked")
    }
}

/// Only web and mail links open; anything else in a document is ignored.
fileprivate func weftURL(_ href: String) -> URL? {
    guard let url = URL(string: href) else { return nil }
    switch url.scheme?.lowercased() {
    case "http", "https", "mailto", nil: return url
    default: return nil
    }
}

// Weft reads any value as text, a flag or a number (SPEC §2.1); these convert the model's types.
fileprivate func weftText(_ v: Int) -> String { String(v) }
fileprivate func weftText(_ v: Bool) -> String { v ? "true" : "false" }
fileprivate func weftText<T>(_ v: T) -> String { "" }
// An array or object is true even when empty (SPEC §2.1): only the model's scalars can be false.
fileprivate func weftOn<T>(_ v: T) -> Bool { true }
fileprivate func weftInt(_ v: String) -> Int { Int(v) ?? 0 }
fileprivate func weftInt(_ v: Bool) -> Int { v ? 1 : 0 }
fileprivate func weftInt<T>(_ v: T) -> Int { 0 }
fileprivate func weftColumns(_ v: Int) -> Int { max(1, v) }
fileprivate func weftHeadingLevel(_ v: Int) -> AccessibilityHeadingLevel {
    switch min(max(v, 1), 6) { case 1: .h1; case 2: .h2; case 3: .h3; case 4: .h4; case 5: .h5; default: .h6 }
}
fileprivate func weftHeadingFont(_ v: Int) -> Font {
    switch min(max(v, 1), 6) { case 1: .largeTitle; case 2: .title; case 3: .title2; case 4: .title3; case 5: .headline; default: .subheadline }
}
