---
source: crates/weft-snapshots/tests/snapshots.rs
description: example-review with light and dark tokens
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Review</title>
<style>
:root {
  color-scheme: light dark;
  --weft-color-brand: #d97706;
  --weft-color-star: #d97706;
  --weft-space-sm: 8px;
  --weft-space-md: 16px;
  --weft-font-body: 400 16px/1.5 system-ui;
  --weft-font-body-letter-spacing: 0.2px;
}
@media (prefers-color-scheme: dark) {
  :root {
    --weft-color-brand: #fbbf24;
    --weft-color-star: #fbbf24;
  }
}
.weft-stack { display: flex; flex-direction: column; }
.weft-row { display: flex; flex-direction: row; }
.weft-grid { display: grid; }
[data-align="start"] { align-items: flex-start; }
[data-align="center"] { align-items: center; }
[data-align="end"] { align-items: flex-end; }
[data-align="stretch"] { align-items: stretch; }
[data-wrap] { flex-wrap: wrap; }
a { display: inline-block; }
[hidden] { display: none !important; }
</style>
</head>
<body>
<main data-weft-id="review" aria-label="Review">
  <h1 data-weft-id="title">Review your order</h1>
  <template data-weft-id="lines" data-each="$.cart.items" data-as="line">
    <div data-weft-id="line" class="weft-row" style="gap: var(--weft-space-sm)">
      <div data-weft-id="line-name" data-weft-kind="text" data-bind="text:$line.name"></div>
      <div data-weft-id="line-score" data-prop-color="{token.color.star}" aria-label="Customer score" data-weft-kind="rating" role="img" data-bind="value:$line.score">
      </div>
    </div>
  </template>
  <div data-weft-id="empty" data-tone="muted" data-weft-kind="text" data-bind="hidden:!$.cart.empty">Nothing to review.</div>
  <button data-weft-id="checkout" type="button" data-variant="primary" data-bind="disabled:$.busy" data-action="press:cart.checkout">Place order</button>
</main>
</body>
</html>
