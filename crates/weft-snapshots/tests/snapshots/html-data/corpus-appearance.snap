---
source: crates/weft-snapshots/tests/snapshots.rs
description: corpus-appearance as html-data
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Appearance</title>
<style>
:root {
  --weft-space-xs: 4px;
  --weft-space-sm: 8px;
  --weft-space-md: 16px;
  --weft-space-lg: 24px;
  --weft-space-xl: 32px;
  --weft-radius-sm: 4px;
  --weft-radius-md: 8px;
  --weft-radius-pill: 999px;
  --weft-font-size-sm: 0.875rem;
  --weft-font-size-md: 1rem;
  --weft-font-size-lg: 1.25rem;
  --weft-font-size-xl: 1.75rem;
  --weft-color-white: #ffffff;
  --weft-color-ink: #1a1c21;
  --weft-color-blue-_root: #2563eb;
  --weft-color-red: #dc2626;
  --weft-color-action-primary: #2563eb;
  --weft-color-action-danger: #dc2626;
}
.weft-stack { display: flex; flex-direction: column; }
.weft-row { display: flex; flex-direction: row; }
.weft-grid { display: grid; }
[data-align="start"] { align-items: flex-start; }
[data-align="center"] { align-items: center; }
[data-align="end"] { align-items: flex-end; }
[data-align="stretch"] { align-items: stretch; }
[data-wrap] { flex-wrap: wrap; }
a { display: inline-block; }
[hidden] { display: none !important; }
</style>
</head>
<body>
<main data-weft-id="appearance" aria-label="Appearance">
  <h1 data-weft-id="title">Appearance</h1>
  <div data-weft-id="options" class="weft-stack" data-align="stretch" style="gap: var(--weft-space-md)">
    <div data-weft-id="theme" aria-label="Theme" role="radiogroup" data-weft-segmented>
      <span aria-hidden="true">Theme</span><label><input data-weft-id="theme-light" type="radio" name="weft-theme" value="light" aria-label="Light"><span aria-hidden="true">Light</span></label><label><input data-weft-id="theme-dark" type="radio" name="weft-theme" value="dark" disabled aria-label="Dark"><span aria-hidden="true">Dark</span></label><label><input data-weft-id="theme-auto" type="radio" name="weft-theme" checked value="auto" aria-label="Automatic"><span aria-hidden="true">Automatic</span></label>
    </div>
    <label><span aria-hidden="true">Text size</span><input data-weft-id="size" aria-label="Text size" type="range" min="12" max="24" step="1" value="16"></label><label><span aria-hidden="true">Contrast</span><input data-weft-id="contrast" aria-label="Contrast" type="range" min="0" max="100" step="1" value="60" disabled></label><label><span aria-hidden="true">Columns</span><span data-weft-stepper><button type="button" tabindex="-1" aria-hidden="true" data-weft-step="down">−</button><input data-weft-id="columns" aria-label="Columns" type="number" step="1" value="2"><button type="button" tabindex="-1" aria-hidden="true" data-weft-step="up">+</button></span></label><label><span aria-hidden="true">Zoom</span><span data-weft-stepper><button type="button" tabindex="-1" aria-hidden="true" data-weft-step="down">−</button><input data-weft-id="zoom" aria-label="Zoom" type="number" max="3" step="0.5" value="1.5"><button type="button" tabindex="-1" aria-hidden="true" data-weft-step="up">+</button></span></label><label><span aria-hidden="true">Accent colour</span><input data-weft-id="accent" aria-label="Accent colour" type="color" value="#d946ef" disabled></label><label><span aria-hidden="true">Member since</span><input data-weft-id="since" aria-label="Member since" type="date" value="2024-05-17" disabled></label><label><span aria-hidden="true">Font</span><input data-weft-id="font" aria-label="Font" list="weft-font-options" disabled value="Inter">
      <datalist id="weft-font-options">
        <option data-weft-id="font-inter" value="Inter">Inter</option>
        <option data-weft-id="font-mono" value="Menlo">Menlo</option>
      </datalist>
    </label>
  </div>
</main>
</body>
</html>
