---
source: crates/weft-snapshots/tests/snapshots.rs
description: corpus-account as html-data
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Edit account</title>
<style>
:root {
  --weft-space-xs: 4px;
  --weft-space-sm: 8px;
  --weft-space-md: 16px;
  --weft-space-lg: 24px;
  --weft-space-xl: 32px;
  --weft-radius-sm: 4px;
  --weft-radius-md: 8px;
  --weft-radius-pill: 999px;
  --weft-font-size-sm: 0.875rem;
  --weft-font-size-md: 1rem;
  --weft-font-size-lg: 1.25rem;
  --weft-font-size-xl: 1.75rem;
  --weft-color-white: #ffffff;
  --weft-color-ink: #1a1c21;
  --weft-color-blue-_root: #2563eb;
  --weft-color-red: #dc2626;
  --weft-color-action-primary: #2563eb;
  --weft-color-action-danger: #dc2626;
}
.weft-stack { display: flex; flex-direction: column; }
.weft-row { display: flex; flex-direction: row; }
.weft-grid { display: grid; }
[data-align="start"] { align-items: flex-start; }
[data-align="center"] { align-items: center; }
[data-align="end"] { align-items: flex-end; }
[data-align="stretch"] { align-items: stretch; }
[data-wrap] { flex-wrap: wrap; }
a { display: inline-block; }
[hidden] { display: none !important; }
</style>
</head>
<body>
<main data-weft-id="account" aria-label="Edit account">
  <h1 data-weft-id="title">Edit account</h1>
  <form data-weft-id="account-form" aria-label="Account" data-state="invalid" data-action="submit:account.save">
    <div data-weft-field>
      <label><span aria-hidden="true">Full name</span><input data-weft-id="name" aria-label="Full name" data-state="valid" type="text" placeholder="Ada Lovelace" value="Ada Lovelace" data-action="change:account.edit"></label>
    </div>
    <div data-weft-field>
      <label><span aria-hidden="true">Age</span><input data-weft-id="age" aria-label="Age" data-state="invalid" type="number" aria-invalid="true" aria-describedby="weft-age-error" value="17"></label>
      <div id="weft-age-error">You must be 18 or older.</div>
    </div>
    <div data-weft-field>
      <label><span aria-hidden="true">Handle</span><input data-weft-id="handle" aria-label="Handle" type="text" placeholder="{handle}" value="ada"></label>
    </div>
    <div data-weft-field>
      <label><span aria-hidden="true">Bio</span><textarea data-weft-id="bio" aria-label="Bio">Wrote the first program.</textarea></label>
    </div>
    <div data-weft-field>
      <label><span aria-hidden="true">Email</span><input data-weft-id="email" aria-label="Email" type="email" disabled value="ada@example.com"></label>
    </div>
    <label><input data-weft-id="newsletter" aria-label="Send me the newsletter" type="checkbox" checked data-action="change:account.edit"><span aria-hidden="true">Send me the newsletter</span></label><label><input data-weft-id="terms" aria-label="Terms accepted" type="checkbox" checked disabled><span aria-hidden="true">Terms accepted</span></label><label><input data-weft-id="public" aria-label="Public profile" type="checkbox" role="switch" data-action="change:account.edit"><span aria-hidden="true">Public profile</span></label>
    <div data-weft-id="plan" aria-label="Plan" role="radiogroup" data-action="change:account.edit">
      <span aria-hidden="true">Plan</span><label><input data-weft-id="plan-free" type="radio" name="weft-plan" value="free" aria-label="Free"><span aria-hidden="true">Free</span></label><label><input data-weft-id="plan-pro" type="radio" name="weft-plan" checked value="pro" aria-label="Pro"><span aria-hidden="true">Pro</span></label><label><input data-weft-id="plan-team" type="radio" name="weft-plan" value="team" disabled aria-label="Team"><span aria-hidden="true">Team</span></label>
    </div>
    <label><span aria-hidden="true">Language</span><select data-weft-id="language" aria-label="Language" data-action="change:account.edit">
        <option data-weft-id="language-en" value="en">English</option>
        <option data-weft-id="language-fr" selected value="fr">Français</option>
      </select></label>
    <div data-weft-id="internal" hidden data-weft-kind="text">Internal note: never shown.</div>
    <div data-weft-id="saved" hidden role="alert" data-tone="success">Your changes were saved.</div>
    <footer data-weft-slot="footer">
      <button data-weft-id="save" data-state="busy" type="submit" data-variant="primary">Save</button><button data-weft-id="cancel" data-state="idle" type="button" data-variant="secondary" data-action="press:account.cancel">Cancel</button><a data-weft-id="help" href="https://example.com/help">Help</a>
    </footer>
  </form>
</main>
</body>
</html>
