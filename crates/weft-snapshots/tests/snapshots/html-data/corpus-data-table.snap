---
source: crates/weft-snapshots/tests/snapshots.rs
description: corpus-data-table as html-data
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Users</title>
<style>
:root {
  --weft-space-xs: 4px;
  --weft-space-sm: 8px;
  --weft-space-md: 16px;
  --weft-space-lg: 24px;
  --weft-space-xl: 32px;
  --weft-radius-sm: 4px;
  --weft-radius-md: 8px;
  --weft-radius-pill: 999px;
  --weft-font-size-sm: 0.875rem;
  --weft-font-size-md: 1rem;
  --weft-font-size-lg: 1.25rem;
  --weft-font-size-xl: 1.75rem;
  --weft-color-white: #ffffff;
  --weft-color-ink: #1a1c21;
  --weft-color-blue-_root: #2563eb;
  --weft-color-red: #dc2626;
  --weft-color-action-primary: #2563eb;
  --weft-color-action-danger: #dc2626;
}
.weft-stack { display: flex; flex-direction: column; }
.weft-row { display: flex; flex-direction: row; }
.weft-grid { display: grid; }
[data-align="start"] { align-items: flex-start; }
[data-align="center"] { align-items: center; }
[data-align="end"] { align-items: flex-end; }
[data-align="stretch"] { align-items: stretch; }
[data-wrap] { flex-wrap: wrap; }
.weft-field label, .weft-toggle { display: flex; gap: 0.5em; }
.weft-field label { flex-direction: column; }
[hidden] { display: none !important; }
</style>
</head>
<body>
<main data-weft-id="users" aria-label="Users">
  <h1 data-weft-id="title">Users</h1>
  <table data-weft-id="table" aria-label="Users">
    <thead>
      <tr>
        <th data-weft-id="col-name" scope="col" aria-sort="ascending" data-action="press:users.sort">Name</th>
        <th data-weft-id="col-email" scope="col" aria-sort="none" data-action="press:users.sort">Email</th>
        <th data-weft-id="col-role" scope="col" aria-sort="none" data-action="press:users.sort">Role</th>
        <th data-weft-id="col-actions" scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
      <tr data-weft-id="row[0]">
        <td data-weft-id="cell-name[0]">
          <p data-weft-id="user-name[0]">Ada Lovelace</p>
        </td>
        <td data-weft-id="cell-email[0]">
          <p data-weft-id="user-email[0]">ada@example.com</p>
        </td>
        <td data-weft-id="cell-role[0]">
          <p data-weft-id="user-role[0]">Admin</p>
        </td>
        <td data-weft-id="cell-actions[0]">
          <button data-weft-id="delete[0]" type="button" data-variant="danger" data-action="press:users.delete">Delete</button>
        </td>
      </tr>
      <tr data-weft-id="row[1]">
        <td data-weft-id="cell-name[1]">
          <p data-weft-id="user-name[1]">Alan Turing</p>
        </td>
        <td data-weft-id="cell-email[1]">
          <p data-weft-id="user-email[1]">alan@example.com</p>
        </td>
        <td data-weft-id="cell-role[1]">
          <p data-weft-id="user-role[1]">Editor</p>
        </td>
        <td data-weft-id="cell-actions[1]">
          <button data-weft-id="delete[1]" type="button" data-variant="danger" data-action="press:users.delete">Delete</button>
        </td>
      </tr>
    </tbody>
  </table>
</main>
</body>
</html>
