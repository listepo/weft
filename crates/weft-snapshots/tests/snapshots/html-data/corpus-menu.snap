---
source: crates/weft-snapshots/tests/snapshots.rs
description: corpus-menu as html-data
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Account menu</title>
<style>
:root {
  --weft-space-xs: 4px;
  --weft-space-sm: 8px;
  --weft-space-md: 16px;
  --weft-space-lg: 24px;
  --weft-space-xl: 32px;
  --weft-radius-sm: 4px;
  --weft-radius-md: 8px;
  --weft-radius-pill: 999px;
  --weft-font-size-sm: 0.875rem;
  --weft-font-size-md: 1rem;
  --weft-font-size-lg: 1.25rem;
  --weft-font-size-xl: 1.75rem;
  --weft-color-white: #ffffff;
  --weft-color-ink: #1a1c21;
  --weft-color-blue-_root: #2563eb;
  --weft-color-red: #dc2626;
  --weft-color-action-primary: #2563eb;
  --weft-color-action-danger: #dc2626;
}
.weft-stack { display: flex; flex-direction: column; }
.weft-row { display: flex; flex-direction: row; }
.weft-grid { display: grid; }
[data-align="start"] { align-items: flex-start; }
[data-align="center"] { align-items: center; }
[data-align="end"] { align-items: flex-end; }
[data-align="stretch"] { align-items: stretch; }
[data-wrap] { flex-wrap: wrap; }
a { display: inline-block; }
[hidden] { display: none !important; }
</style>
</head>
<body>
<main data-weft-id="account-menu" aria-label="Account menu">
  <div data-weft-id="signed-in" data-weft-kind="text">ada@example.com</div>
  <div data-weft-id="menu" aria-label="Account" role="menu">
    <button data-weft-id="item-profile" type="button" role="menuitem" data-action="press:nav.profile">Profile</button><button data-weft-id="item-settings" type="button" role="menuitem" data-action="press:nav.settings">Settings</button><button data-weft-id="item-billing" type="button" role="menuitem" disabled data-action="press:nav.billing">Billing</button><button data-weft-id="item-signout" type="button" role="menuitem" data-action="press:auth.signout">Sign out</button>
  </div>
</main>
</body>
</html>
