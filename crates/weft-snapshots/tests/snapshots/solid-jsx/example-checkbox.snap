---
source: crates/weft-snapshots/tests/snapshots.rs
description: example-checkbox as solid-jsx
---
function _on(v) {
  return v === "false" ? false : Boolean(v);
}

function _act(actions, event) {
  if (typeof actions !== "object" || actions === null || !Object.hasOwn(actions, event.action)) return;
  const fn = actions[event.action];
  if (typeof fn === "function") fn(event);
}

export default function WeftScreen(props) {
  return (
    <main data-weft-id="root" aria-label="Terms">
      <label>
        <input data-weft-id="terms" type="checkbox" aria-label="I accept the terms" checked={_on(props.data?.acceptTerms)} onChange={(_e) => { props.onChange?.("$.acceptTerms", _e.currentTarget.checked); _act(props.actions, { id: "terms", action: "form.edit" }); }} />
        <span aria-hidden="true">I accept the terms</span>
      </label>
    </main>
  );
}
