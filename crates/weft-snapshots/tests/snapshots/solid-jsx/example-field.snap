---
source: crates/weft-snapshots/tests/snapshots.rs
description: example-field as solid-jsx
---
import { Show } from "solid-js";

function _text(v) {
  if (typeof v === "string") return v;
  if (typeof v === "number") return Number.isFinite(v) ? String(v) : "";
  if (typeof v === "boolean") return String(v);
  return "";
}

function _act(actions, event) {
  if (typeof actions !== "object" || actions === null || !Object.hasOwn(actions, event.action)) return;
  const fn = actions[event.action];
  if (typeof fn === "function") fn(event);
}

export default function WeftScreen(props) {
  return (
    <main data-weft-id="root" aria-label="Sign up">
      <div data-weft-field="">
        <label>
          <span aria-hidden="true">Email</span>
          <input data-weft-id="email" data-state="valid" aria-label="Email" type="email" placeholder="you@example.com" required aria-invalid={"valid" === "invalid" || _text(props.data?.errors?.email) !== "" ? "true" : undefined} aria-describedby={_text(props.data?.errors?.email) ? "weft-email-error" : undefined} value={_text(props.data?.email)} onInput={(_e) => { props.onChange?.("$.email", _e.currentTarget.value); _act(props.actions, { id: "email", action: "form.edit" }); }} />
        </label>
        <Show when={_text(props.data?.errors?.email)}>
          <div id={"weft-email-error"}>
            {_text(props.data?.errors?.email)}
          </div>
        </Show>
      </div>
    </main>
  );
}
