---
source: crates/weft-snapshots/tests/snapshots.rs
description: example-text as solid-jsx
---
function _text(v) {
  if (typeof v === "string") return v;
  if (typeof v === "number") return Number.isFinite(v) ? String(v) : "";
  if (typeof v === "boolean") return String(v);
  return "";
}

function _squash(v) {
  return v.trim().replace(/\s+/g, " ");
}

export default function WeftScreen(props) {
  return (
    <main data-weft-id="root" aria-label="Status">
      <div data-weft-id="saved" data-tone="success">All changes saved.</div>
      <div data-weft-id="user">
        {!(_text(props.data?.user?.name).trim() === "") ? _squash(_text(props.data?.user?.name)) : ""}
      </div>
    </main>
  );
}
