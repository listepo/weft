---
source: crates/weft-snapshots/tests/snapshots.rs
description: corpus-tabs as lit-js
---
import { LitElement, html, nothing } from "lit";

function _text(v) {
  if (typeof v === "string") return v;
  if (typeof v === "number") return Number.isFinite(v) ? String(v) : "";
  if (typeof v === "boolean") return String(v);
  return "";
}

function _squash(v) {
  return v.trim().replace(/\s+/g, " ");
}

function _list(v) {
  return Array.isArray(v) ? v : [];
}

function _act(actions, event) {
  if (typeof actions !== "object" || actions === null || !Object.hasOwn(actions, event.action)) return;
  const fn = actions[event.action];
  if (typeof fn === "function") fn(event);
}

function _busy(state) {
  return state === "loading" || state === "busy" || state === "submitting" ? "true" : undefined;
}

function _tabKey(e, i, count, choose) {
  const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
  if (step === 0 || count === 0) return;
  e.preventDefault();
  const next = (i + step + count) % count;
  choose(next);
  e.currentTarget.parentElement?.querySelectorAll('[role="tab"]')[next]?.focus();
}

class WeftScreen extends LitElement {
  static properties = {
    data: { attribute: false },
    actions: { attribute: false },
    onChange: { attribute: false },
  };

  // The light DOM, so the page's stylesheet and the ids that labels refer to reach the controls.
  createRenderRoot() {
    return this;
  }

  render() {
    const { data, actions, onChange } = this;
    return html`<main data-weft-id="account" aria-label="Account"
      ><h1 data-weft-id="title">Account</h1>${(() => {
        const _t = [
          { id: "tab-overview", doc: "tab-overview", state: "", label: "Overview", panel: html`<div data-weft-id="account-name">${!(_text(data?.account?.name).trim() === "") ? _squash(_text(data?.account?.name)) : ""}</div
            ><div data-weft-id="account-email">${!(_text(data?.account?.email).trim() === "") ? _squash(_text(data?.account?.email)) : ""}</div>` },
          { id: "tab-billing", doc: "tab-billing", state: "", label: "Billing", panel: html`<div data-weft-id="plan">${!(_text(data?.billing?.plan).trim() === "") ? _squash(_text(data?.billing?.plan)) : ""}</div
            ><button data-weft-id="change-plan" type="button" data-variant="primary" @click=${(_e) => _act(actions, { id: "change-plan", action: "billing.change" })}>Change plan</button>` },
          { id: "tab-team", doc: "tab-team", state: "", label: "Team", panel: html`<ul data-weft-id="members">${_list(data?.team).map((member, _i0) => html`<li data-weft-id=${"member[" + _i0 + "]"}
                  ><div data-weft-id=${"member-name[" + _i0 + "]"}>${!(_text(member?.name).trim() === "") ? _squash(_text(member?.name)) : ""}</div
                ></li>`)}</ul>` },
        ];
        const _s = Math.max(0, _t.findIndex((_x) => _x.doc === "" || _x.id === ""));
        const _choose = (_k) => { const _x = _t[_k]; if (!_x || _k === _s) return; };
        return html`<div data-weft-tabs=""
            ><div data-weft-id="tabs" aria-label="Account sections" role="tablist">${_t.map((_x, _k) => html`<button data-weft-id=${(_x.id || undefined) ?? nothing} data-state=${(_x.state || undefined) ?? nothing} aria-busy=${(_busy(_x.state)) ?? nothing} type="button" role="tab" id=${"weft-" + _x.id + "-tab"} aria-selected=${String(_k === _s)} aria-controls=${"weft-" + _x.id + "-panel"} tabindex=${(_k === _s ? 0 : -1) ?? nothing} @click=${() => _choose(_k)} @keydown=${(_e) => _tabKey(_e, _k, _t.length, _choose)}>${_x.label}</button>`)}</div>${_t.map((_x, _k) => html`<div role="tabpanel" id=${"weft-" + _x.id + "-panel"} aria-labelledby=${"weft-" + _x.id + "-tab"} ?hidden=${_k !== _s} tabindex=${0}>${_x.panel}</div>`)}</div>`;
      })()}</main>`;
  }
}

if (!customElements.get("weft-screen")) customElements.define("weft-screen", WeftScreen);

export default WeftScreen;
