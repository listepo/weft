{
  "color": {
    "$type": "color",
    "accent": { "$value": { "colorSpace": "display-p3", "components": [0.85, 0.47, 0.02] } },
    "brand": { "$value": "#d97706" },
    "surface": {
      "$root": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "raised": { "$value": { "colorSpace": "srgb", "components": [0.96, 0.96, 0.96], "alpha": 0.9 } }
    }
  },
  "space": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 1, "unit": "rem" } }
  }
}
