<screen id="leaderboard" label="Leaderboard" weft="0.1">
  <heading id="title" level="1">Leaderboard</heading>
  <stack id="leader" direction="row" gap="{token.space.xs}">
    <text id="leader-label">In the lead:</text>
    <text id="leader-name" text="{$.players.0.name}"/>
  </stack>
  <list id="players" ordered="true">
    <each id="player-each" as="player" in="{$.players}">
      <item id="player">
        <text id="player-name" text="{$player.name}"/>
        <text id="player-score" text="{$player.score}" tone="muted"/>
      </item>
    </each>
  </list>
</screen>
