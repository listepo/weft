[
  {
    "version": "v0.9",
    "createSurface": {
      "surfaceId": "load-error",
      "catalogId": "https://a2ui.org/specification/v0_9/catalogs/basic/catalog.json"
    }
  },
  {
    "version": "v0.9",
    "updateComponents": {
      "surfaceId": "load-error",
      "components": [
        {
          "id": "root",
          "component": "Column",
          "children": ["alert", "actions"]
        },
        {
          "id": "alert",
          "component": "Card",
          "child": "alert-body"
        },
        {
          "id": "alert-body",
          "component": "Column",
          "children": ["error-title", "error-message"]
        },
        {
          "id": "error-title",
          "component": "Text",
          "text": "Could not load your data",
          "variant": "h2"
        },
        {
          "id": "error-message",
          "component": "Text",
          "text": {
            "path": "/error/message"
          }
        },
        {
          "id": "actions",
          "component": "Row",
          "children": ["retry", "support"]
        },
        {
          "id": "retry",
          "component": "Button",
          "child": "retry-label",
          "variant": "primary",
          "action": {
            "event": {
              "name": "load.retry"
            }
          }
        },
        {
          "id": "retry-label",
          "component": "Text",
          "text": "Retry"
        },
        {
          "id": "support",
          "component": "Button",
          "child": "support-label",
          "variant": "borderless",
          "action": {
            "event": {
              "name": "nav.support"
            }
          }
        },
        {
          "id": "support-label",
          "component": "Text",
          "text": "Contact support"
        }
      ]
    }
  }
]
