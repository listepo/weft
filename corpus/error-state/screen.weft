<screen id="load-error" label="Load error" state="error" weft="0.1">
  <alert id="alert" tone="danger">
    <heading id="error-title" level="2">Could not load your data</heading>
    <text id="error-message" text="{$.error.message}"/>
  </alert>
  <stack id="actions" direction="row" gap="{token.space.sm}">
    <button id="retry" variant="primary" on-press="load.retry">Retry</button>
    <link id="support" on-press="nav.support">Contact support</link>
  </stack>
</screen>
