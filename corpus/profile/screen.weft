<screen id="profile" label="Profile" weft="0.1">
  <image id="avatar" label="Profile photo" src="{$.user.avatar}"/>
  <heading id="name" level="1" text="{$.user.name}"/>
  <text id="bio" text="{$.user.bio}"/>
  <heading id="links-title" level="2">Links</heading>
  <stack id="links" direction="row" gap="{token.space.md}">
    <link id="website" href="{$.user.website}">Website</link>
    <link id="github" href="{$.user.github}">GitHub</link>
  </stack>
  <button id="edit" on-press="profile.edit">Edit profile</button>
</screen>
